<resources xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <!--
        Base application theme, dependent on API level. This theme is replaced
        by AppBaseTheme from res/values-vXX/styles.xml on newer devices.
    -->
    <style name="AppTheme.Base" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/background</item>
        <item name="actionOverflowMenuStyle">@style/OverflowMenu</item>
        <item name="android:dropDownListViewStyle">@style/mySpinnerStyle</item>
        <item name="android:statusBarColor">@color/statusbarColor</item>
    </style>

    <style name="AppTheme" parent="AppTheme.Base"/>
    <!-- Application theme. -->
    <style name="DrawerArrowStyle" parent="Widget.AppCompat.DrawerArrowToggle">
        <item name="spinBars">true</item>
        <item name="color">@android:color/white</item>
    </style>

    <style name="ToolBarStyle" parent="">
        <item name="popupTheme">@style/ThemeOverlay.AppCompat.Light</item>
        <item name="theme">@style/DriverSpaHomeActionBar</item>
    </style>

    <style name="MyPopupMenu"
        parent="@android:style/Widget.Holo.ListPopupWindow">
        <item name="android:popupBackground">@color/background_main</item>
    </style>

    <style name="DriverSpaHomeActionBar" parent="@style/ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="AppTheme.WhiteAccent">
        <item name="colorAccent">@color/White</item> <!-- Whatever color you want-->
    </style>

    <style name="DriverSpaAppTheme" parent="AppTheme.Base">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@drawable/background</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:itemBackground">@color/background_main</item>
        <item name="android:popupMenuStyle">@style/MyPopupMenu</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="colorPrimary">@color/BlueLight</item>
        <item name="colorPrimaryDark">@color/BlueLight</item>
        <item name="colorAccent">@color/BlueLight</item>
        <item name="android:textColorPrimary">@color/BlueLight</item>
        <item name="colorControlNormal">@color/actionbar_color</item>
        <item name="drawerArrowStyle">@style/DrawerArrowStyle</item>
        <item name="android:textViewStyle">@style/DriverSpaTextViewStyle</item>
        <item name="android:seekBarStyle">@style/SeekBarAppTheme</item>
        <item name="android:ratingBarStyle">@style/RatingBarAppTheme</item>
        <item name="android:buttonStyleToggle">@style/ToggleAppTheme</item>
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
    </style>

    <!--<style name="OverflowMenu" parent="Widget.AppCompat.PopupMenu.Overflow">-->
    <!--&lt;!&ndash; Required for pre-Lollipop. &ndash;&gt;-->
    <!--<item name="overlapAnchor">false</item>-->

    <!--&lt;!&ndash; Required for Lollipop. &ndash;&gt;-->
    <!--<item name="android:overlapAnchor">false</item>-->
    <!--</style>-->

    <style name="OverflowMenu" parent="@style/Widget.AppCompat.Light.PopupMenu">
        <item name="overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">-36dip</item>
    </style>

    <style name="mySpinnerStyle" parent="android:Widget.ListView.DropDown">
        <item name="android:divider">@color/BlueLight</item>
        <item name="android:dividerHeight">1dp</item>
    </style>

    <style name="CustomTextInputLayoutStyle.ErrorTextStyle" parent="TextAppearance.Design.Error">
        <item name="android:textSize">6sp</item>
    </style>

    <style name="TextInputHint.BlueLight" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textColor">@color/BlueLight</item>
    </style>

    <style name="TextInputHint.ActionBarColor" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textColor">@color/actionbar_color</item>
    </style>

    <style name="DriverSpaTextViewStyle" parent="@android:style/TextAppearance">
        <item name="android:textColor">@color/White</item>
        <item name="android:fontFamily" tools:ignore="NewApi">sans-serif-light</item>
    </style>

    <!-- ActionBar styles -->
    <style name="EditText">
        <item name="android:paddingLeft">5dp</item>
    </style>

    <style name="EditText2">
        <item name="android:paddingLeft">5dp</item>
    </style>


    <style name="EditText.White" parent="EditText">
        <item name="android:background">@color/White</item>
    </style>

    <style name="EditText.BlackBorder" parent="EditText">
        <item name="android:background">@color/Black</item>
    </style>

    <style name="EditText.Transparent" parent="EditText">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="EditText.Transparent.WhiteBorder" parent="EditText">
        <item name="android:background">@drawable/background_button_grid</item>
    </style>

    <style name="TransparentBackground" parent="android:Theme.Light">
        <item name="android:windowIsTranslucent">true</item> <!-- подлупрозрачность окна -->
        <item name="android:windowBackground">@android:color/transparent</item> <!-- прозрачный цвет бэкграунда -->
        <item name="android:windowContentOverlay">@null</item> <!-- отключаем оверлей содержимого окна -->
        <item name="android:windowNoTitle">true</item> <!-- отключаем заголовок -->
        <item name="android:windowIsFloating">true</item> <!-- окно в любой части экрана -->
        <item name="android:backgroundDimEnabled">false</item> <!-- отключаем затемнение -->
    </style>

    <style name="DialogWithNoActionBar" parent="android:Theme.Holo.Light.NoActionBar">
        <item name="android:textColorPrimary">@color/White</item>
    </style>

    <style name="SeekBarAppTheme" parent="android:Widget.SeekBar">
        <item name="android:progressDrawable">@drawable/apptheme_scrubber_progress_horizontal_holo_light</item>
        <item name="android:indeterminateDrawable">@drawable/apptheme_scrubber_progress_horizontal_holo_light</item>
        <item name="android:minHeight">13dip</item>
        <item name="android:maxHeight">13dip</item>
        <item name="android:thumb">@drawable/apptheme_scrubber_control_selector_holo_light</item>
        <item name="android:thumbOffset">16dip</item>
        <item name="android:paddingLeft">16dip</item>
        <item name="android:paddingRight">16dip</item>
    </style>

    <style name="RatingBarAppTheme" parent="android:Widget.RatingBar">
        <item name="android:progressDrawable">@drawable/background_rating_bar_small</item>
        <item name="android:indeterminateDrawable">@drawable/background_rating_bar_small</item>
    </style>

    <style name="ToggleAppTheme" parent="android:Widget.Button.Toggle">
        <item name="android:background">@drawable/apptheme_btn_toggle_holo_light</item>
        <item name="android:minHeight">48dip</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="RatingBar" parent="@android:style/Widget.RatingBar">
        <item name="android:progressDrawable">@drawable/background_rating_bar_empty</item>
        <item name="android:minHeight">23dip</item>
        <item name="android:maxHeight">25dip</item>
    </style>

    <style name="EditText.RoundedTransparent" parent="EditText">
        <item name="android:background">@drawable/background_input_transparent</item>
    </style>

    <style name="SpinnerThemeOverlay" parent="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>

    <!-- Payment window (dialog_payment): tab chips and the "mixed" amount rows -->
    <style name="PaymentTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:background">@drawable/bg_v2_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/White</item>
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <style name="PaymentMixedRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="PaymentMixedLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/BlueLight</item>
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <style name="PaymentMixedField">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_v2_field</item>
        <item name="android:gravity">end</item>
        <item name="android:hint">0</item>
        <item name="android:imeOptions">actionDone</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">7</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/White</item>
        <item name="android:textColorHint">@color/BlueLight</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <!-- Shop screens (docs/shop.md): form labels and fields, list rows -->
    <style name="ShopLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/BlueLight</item>
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <style name="ShopField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/bg_v2_field</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColor">@color/White</item>
        <item name="android:textColorHint">@color/BlueLight</item>
        <item name="android:textSize">@dimen/text_normal</item>
    </style>

    <style name="ShopCardValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/White</item>
        <item name="android:textSize">@dimen/text_medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Speed dial of the + button on the home screen (activity_admin_home) -->
    <style name="SpeedDialRow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SpeedDialLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginRight">16dp</item>
        <item name="android:background">@drawable/bg_speed_dial_label</item>
        <item name="android:elevation">2dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">#DE000000</item>
        <item name="android:textSize">@dimen/text_normal</item>
    </style>

    <style name="SpeedDialFab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="fabSize">mini</item>
        <item name="backgroundTint">@color/White</item>
        <item name="tint">@color/Red</item>
    </style>

    <!-- Bottom navigation of the home screen -->
    <style name="NavTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="NavTabIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="tint">@color/nav_item_color</item>
    </style>

    <style name="NavTabLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/nav_item_color</item>
        <item name="android:textSize">@dimen/text_smaller</item>
    </style>

    <!-- Rows of the More tab -->
    <style name="MoreCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/bg_more_card</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="MoreRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="MoreRowIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginRight">16dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/White</item>
    </style>

    <style name="MoreRowTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/White</item>
        <item name="android:textSize">@dimen/text_normal</item>
    </style>

    <style name="MoreRowChevron">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="tint">@color/nav_item_normal</item>
    </style>

    <style name="MoreDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginLeft">56dp</item>
        <item name="android:background">#14FFFFFF</item>
    </style>
</resources>
