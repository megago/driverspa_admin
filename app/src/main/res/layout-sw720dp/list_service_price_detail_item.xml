<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/descLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/horizontal_margin"
            android:paddingRight="@dimen/horizontal_margin"
            android:background="@drawable/background_list_item"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/vertical_margin_third">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Легковая"
                    android:textColor="@color/White"
                    android:textColorHint="@color/actionbar_color"
                    android:textIsSelectable="false"
                    android:textSize="@dimen/text_normal" />

                <TextView
                    android:id="@+id/detail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txtLayout"
                    android:layout_weight="0.6"
                    android:gravity="left"
                    android:text="Показать цены"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_smaller"
                    android:visibility="gone" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin_half">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_checkmark_off" />
                <ImageView
                    android:id="@+id/checkbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/background_list_item_checkmark" />
            </FrameLayout>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/priceLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="@dimen/vertical_margin_third"
            android:paddingLeft="@dimen/horizontal_margin"
            android:paddingRight="@dimen/horizontal_margin"
            android:background="@color/BlackTransparent"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|left"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin_third"
                android:text="Цена"
                android:textSize="@dimen/text_small" />
            <EditText
                android:id="@+id/priceItem"
                style="@style/EditText.Transparent.WhiteBorder"
                android:layout_width="@dimen/price_width"
                android:layout_height="@dimen/price_height"
                android:layout_marginTop="@dimen/vertical_margin_third"
                android:inputType="number"
                android:gravity="bottom|left"
                android:singleLine="true"
                android:textColor="@color/White"
                android:textColorHint="@color/actionbar_color"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/text_small"></EditText>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|left"
                android:layout_marginLeft="@dimen/horizontal_margin_third"
                android:text="₸"
                android:textSize="@dimen/text_small" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|left"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin_third"
                android:text="Время"
                android:textSize="@dimen/text_small" />


            <EditText
                android:id="@+id/timeItem"
                style="@style/EditText.Transparent.WhiteBorder"
                android:layout_width="@dimen/price_width"
                android:layout_height="@dimen/price_height"
                android:layout_marginTop="@dimen/vertical_margin_third"
                android:inputType="number"
                android:singleLine="true"
                android:gravity="bottom|left"
                android:textColor="@color/White"
                android:textColorHint="@color/actionbar_color"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/text_small"></EditText>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|left"
                android:layout_marginLeft="@dimen/horizontal_margin_third"
                android:text="мин."
                android:textSize="@dimen/text_small" />
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_below="@id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/list_divider"></FrameLayout>

</RelativeLayout>