<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parentView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="false"
    android:background="@drawable/background_autocomplete_list_item">

    <!--android:background="@color/background_main"-->
    <TextView
        android:id="@+id/txtClientName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/horizontal_margin_half"
        android:layout_toRightOf="@id/avatarLayout"
        android:text=""
        android:textColor="@color/White"
        android:textSize="@dimen/text_small" />

    <TextView
        android:id="@+id/carType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/horizontal_margin_half"
        android:layout_toRightOf="@id/txtClientName"
        android:text=""
        android:maxLines="1"
        android:ellipsize="end"
        android:textColorLink="@color/GreenYellow"
        android:textColor="@color/White"
        android:textSize="@dimen/text_small" />

    <TextView
        android:id="@+id/mobile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/horizontal_margin_half"
        android:layout_below="@+id/txtClientName"
        android:text="@string/phone_not_specified"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColorLink="@color/GreenYellow"
        android:textColor="@color/GreenYellow"
        android:textSize="@dimen/text_small" />

    <!--android:autoLink="phone"-->
    <TextView
        android:id="@+id/txtFinishedBooksCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/horizontal_margin"
        android:layout_marginTop="@dimen/vertical_margin_third"
        android:layout_below="@+id/txtClientName"
        android:gravity="left"
        android:text=""
        android:visibility="gone"
        android:textColor="@color/White"
        android:textSize="@dimen/text_smaller" />

</RelativeLayout>