<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutGridItem"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_button_grid_item_cars"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/service_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:minHeight="10dp"
            android:minWidth="10dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="5dp"
            android:maxLines="1"
            android:text="Бокс 1"
            android:ellipsize="end"
            android:textColor="@color/White"
            android:textSize="@dimen/text_smaller" />

        <TextView
            android:id="@+id/service_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="top|center"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:text="оффлайн"
            android:textColor="@color/White"
            android:textSize="@dimen/text_smallest" />

    </LinearLayout>

    <ImageView
        android:id="@+id/dot_detail"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="2dp"
        android:layout_gravity="right|top"
        android:paddingBottom="@dimen/horizontal_margin_half"
        android:paddingLeft="@dimen/horizontal_margin_half"
        android:paddingRight="@dimen/horizontal_margin_third"
        android:paddingTop="@dimen/horizontal_margin_third"
        android:src="@drawable/button_three_dot" />

    <FrameLayout
        android:id="@+id/service_count"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="left|top"
        android:layout_marginTop="@dimen/horizontal_margin_third"
        android:layout_marginLeft="@dimen/horizontal_margin_third"
        android:background="@drawable/service_counter">

        <TextView
            android:id="@+id/service_count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="1"
            android:textColor="@color/White"
            android:textSize="@dimen/text_smaller"
            android:textStyle="bold" />
    </FrameLayout>


    <ImageView
        android:id="@+id/unselect_service"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="right|top"
        android:paddingRight="@dimen/horizontal_margin_third"
        android:paddingTop="@dimen/horizontal_margin_third"
        android:paddingBottom="@dimen/horizontal_margin_half"
        android:paddingLeft="@dimen/horizontal_margin_half"
        android:src="@drawable/ic_exit" />

</FrameLayout>
