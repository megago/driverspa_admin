<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/vertical_margin_half"
    android:paddingBottom="@dimen/vertical_margin_half"
    android:background="@drawable/background_list_item">

    <LinearLayout
        android:id="@+id/txtLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@id/arrowRight"
        android:layout_marginRight="@dimen/horizontal_margin_third"
        android:orientation="horizontal" >

        <TextView
            android:id="@+id/description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:text="@string/fifth_wash_free"
            android:textColor="@color/White"
            android:textSize="@dimen/text_normal" />
    </LinearLayout>

    <TextView
        android:id="@+id/washCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtLayout"
        android:layout_weight="1.5"
        android:text="@string/wash_count_5"
        android:textColor="@color/White"
        android:textSize="@dimen/text_small" />

    <ImageView
        android:id="@+id/options"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_alignParentRight="true"
        android:layout_gravity="top"
        android:src="@drawable/button_three_dot" />

</RelativeLayout>