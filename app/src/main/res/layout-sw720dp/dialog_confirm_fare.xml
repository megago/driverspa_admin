<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/BlackTransparent"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/vertical_margin_half">

        <RelativeLayout
            android:id="@+id/mainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginLeft="@dimen/vertical_margin_half"
            android:layout_marginRight="@dimen/vertical_margin_half"
            android:paddingTop="40dp">

            <LinearLayout
                android:id="@+id/testLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:background="@drawable/rounded_half_rectangle_white"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:orientation="vertical"
                android:paddingLeft="@dimen/horizontal_margin_half"
                android:paddingRight="@dimen/horizontal_margin_half"
                android:paddingTop="@dimen/horizontal_margin">

                <TextView
                    style="@style/EditText.Transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/horizontal_margin_third"
                    android:layout_marginRight="@dimen/horizontal_margin_half"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="3"
                    android:text="@string/amount_may_not_interest"
                    android:textColor="@color/Black"
                    android:textSize="@dimen/text_medium"
                    android:textStyle="bold" />

                <TextView
                    style="@style/EditText.Transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/horizontal_margin_third"
                    android:layout_marginRight="@dimen/horizontal_margin_half"
                    android:layout_marginTop="@dimen/horizontal_margin"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="3"
                    android:text="@string/raise_price"
                    android:textColor="@color/Black"
                    android:textSize="@dimen/text_medium"
                    android:textStyle="bold" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/horizontal_margin_third"
                    android:layout_marginRight="@dimen/horizontal_margin_half"
                    android:layout_marginTop="@dimen/vertical_margin_half"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/minusPrice"
                        android:layout_width="90dp"
                        android:layout_height="35dp"
                        android:layout_gravity="center"
                        android:background="@drawable/background_border_green_button"
                        android:enabled="false"
                        android:text="-50"
                        android:textColor="@drawable/button_state_color_green"
                        android:textSize="@dimen/text_normal"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1">

                        <TextView
                            style="@style/EditText.Transparent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:drawableRight="@drawable/ic_tenge_black"
                            android:gravity="center"
                            android:maxLines="3"
                            android:text="100"
                            android:textColor="@color/Black"
                            android:textSize="@dimen/text_medium"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <Button
                        android:id="@+id/plusPrice"
                        android:layout_width="90dp"
                        android:layout_height="35dp"
                        android:layout_gravity="center"
                        android:background="@drawable/background_border_green_button"
                        android:text="+50"
                        android:textColor="#66cd5b"
                        android:textSize="@dimen/text_normal"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnChangeFare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="@dimen/vertical_margin_half"
                    android:layout_marginLeft="@dimen/horizontal_margin_half"
                    android:layout_marginRight="@dimen/horizontal_margin_half"
                    android:layout_marginTop="@dimen/vertical_margin"
                    android:background="@drawable/background_green_button"
                    android:text="@string/change_price"
                    android:enabled="false"
                    android:textAllCaps="false"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_normal" />

                <Button
                    android:id="@+id/btnConfirmFare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="@dimen/vertical_margin"
                    android:layout_marginLeft="@dimen/horizontal_margin_half"
                    android:layout_marginRight="@dimen/horizontal_margin_half"
                    android:layout_marginTop="@dimen/vertical_margin_third"
                    android:background="@drawable/background_green_button"
                    android:text="@string/continue_with_amount"
                    android:textAllCaps="false"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_normal" />

            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>