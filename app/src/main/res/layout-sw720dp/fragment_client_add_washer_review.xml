<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="@dimen/horizontal_margin"
        android:layout_marginRight="@dimen/horizontal_margin"
        android:layout_marginTop="@dimen/vertical_margin_half"
        android:gravity="center"
        android:text="@string/demo_taptaza_2"
        android:textColor="@color/White"
        android:textSize="@dimen/text_normal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/vertical_margin"
        android:gravity="center" >

        <ImageView
            android:id="@+id/star1"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clickable="true"
            android:src="@drawable/background_image_star_big" />

        <ImageView
            android:id="@+id/star2"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clickable="true"
            android:src="@drawable/background_image_star_big" />

        <ImageView
            android:id="@+id/star3"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clickable="true"
            android:src="@drawable/background_image_star_big" />

        <ImageView
            android:id="@+id/star4"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clickable="true"
            android:src="@drawable/background_image_star_big" />

        <ImageView
            android:id="@+id/star5"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clickable="true"
            android:src="@drawable/background_image_star_big" />
    </LinearLayout>

    <EditText
        android:id="@+id/feedback_text"
        style="@style/EditText.Transparent.WhiteBorder"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:layout_marginLeft="@dimen/horizontal_margin"
        android:layout_marginRight="@dimen/horizontal_margin"
        android:layout_marginTop="@dimen/vertical_margin"
        android:autoLink="all"
        android:gravity="top|left"
        android:minLines="1"
        android:scrollbars="none"
        android:textColor="@color/White"
        android:textCursorDrawable="@null" />

    <Button
        android:id="@+id/btnAddReview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/vertical_margin_double"
        android:background="@drawable/background_button_border"
        android:padding="10dp"
        android:text="@string/add_review"
        android:textColor="@drawable/button_state_color"
        android:textSize="22sp" />

</LinearLayout>