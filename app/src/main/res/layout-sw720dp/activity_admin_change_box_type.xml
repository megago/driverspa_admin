<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar_actionbar"
        layout="@layout/toolbar_admin_detail_custom_activity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/vertical_margin"
        android:layout_marginLeft="@dimen/horizontal_margin"
        android:layout_marginRight="@dimen/horizontal_margin"
        android:gravity="center"
        android:text="Бокс 1"
        android:textColor="@color/White"
        android:textSize="@dimen/text_normal" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingBottom="@dimen/vertical_margin">

            <com.google.android.material.textfield.TextInputLayout
            app:hintTextAppearance="@style/TextInputHint.BlueLight"
            app:hintTextColor="@color/BlueLight"
                android:textColorHint="@color/BlueLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/boxName"
                    style="@style/EditText.Transparent"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:hint="Название бокса (Прим. Бокс 1)*"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:text=""
                    android:textColor="@color/White"
                    android:textColorHint="@color/BlueLight"
                    android:textCursorDrawable="@null"
                    android:textIsSelectable="false"
                    android:textSize="@dimen/text_normal" />
            </com.google.android.material.textfield.TextInputLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:visibility="gone"
                android:background="@color/BlueTransparent"/>

            <com.google.android.material.textfield.TextInputLayout
            app:hintTextAppearance="@style/TextInputHint.BlueLight"
            app:hintTextColor="@color/BlueLight"
                android:textColorHint="@color/BlueLight"
                android:layout_width="match_parent"
                android:visibility="gone"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/washerPerson"
                    style="@style/EditText.Transparent"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:hint="Имя мойщика"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:text=""
                    android:textColor="@color/White"
                    android:textColorHint="@color/BlueLight"
                    android:textCursorDrawable="@null"
                    android:textIsSelectable="false"
                    android:textSize="@dimen/text_normal" />
            </com.google.android.material.textfield.TextInputLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:background="@color/BlueTransparent"></FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/offline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@drawable/background_list_item_buttons"
                    android:clickable="true"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/vertical_margin_half"
                    android:paddingTop="@dimen/vertical_margin_half">

                    <TextView
                        android:id="@+id/txtOffline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="5"
                        android:paddingLeft="@dimen/horizontal_margin_half"
                        android:text="Только живая очередь"
                        android:textColor="@color/White"
                        android:textColorHint="@color/BlueLight"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/text_normal" />

                    <ImageView
                        android:id="@+id/offlineImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:src="@drawable/background_list_item_checkmark" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@color/BlueTransparent"></FrameLayout>

                <LinearLayout
                    android:id="@+id/online"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@drawable/background_list_item_buttons"
                    android:clickable="true"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/vertical_margin_half"
                    android:paddingTop="@dimen/vertical_margin_half">

                    <TextView
                        android:id="@+id/txtOnline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="5"
                        android:paddingLeft="@dimen/horizontal_margin_half"
                        android:text="Онлайн бронь и живая очередь"
                        android:textColor="@color/White"
                        android:textColorHint="@color/BlueLight"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/text_normal" />

                    <ImageView
                        android:id="@+id/onlineImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:src="@drawable/background_list_item_checkmark" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@color/BlueTransparent"></FrameLayout>

                <LinearLayout
                    android:id="@+id/hybrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@drawable/background_list_item_buttons"
                    android:clickable="true"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/vertical_margin_half"
                    android:paddingTop="@dimen/vertical_margin_half"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtHybrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="5"
                        android:paddingLeft="@dimen/horizontal_margin_half"
                        android:text="Гибрид"
                        android:textColor="@color/White"
                        android:textColorHint="@color/BlueLight"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/text_normal" />

                    <ImageView
                        android:id="@+id/hybridImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:src="@drawable/background_list_item_checkmark" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@color/BlueTransparent"
                    android:visibility="gone"></FrameLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnEditBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/vertical_margin_double"
                android:background="@drawable/background_button_border"
                android:padding="10dp"
                android:text="Удалить"
                android:visibility="gone"
                android:textColor="@drawable/button_state_color"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnDeleteBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/vertical_margin_double"
                android:background="@drawable/background_button_border"
                android:padding="10dp"
                android:text="Удалить"
                android:textColor="@drawable/button_state_color"
                android:textSize="@dimen/text_normal" />

        </LinearLayout>
    </ScrollView>


</LinearLayout>
