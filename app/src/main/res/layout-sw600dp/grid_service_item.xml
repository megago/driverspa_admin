<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutGridItem"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background_button_grid_item_cars">

    <TextView
        android:id="@+id/service_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:minHeight="10dp"
        android:minWidth="10dp"
        android:paddingRight="2dp"
        android:paddingLeft="2dp"
        android:text="Moika kovrov"
        android:gravity="center"
        android:textColor="@color/White"
        android:textSize="@dimen/text_smaller" />

    <FrameLayout
        android:id="@+id/service_count"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="left|top"
        android:layout_marginTop="@dimen/horizontal_margin_third"
        android:layout_marginLeft="@dimen/horizontal_margin_third"
        android:background="@drawable/service_counter">

        <TextView
            android:id="@+id/service_count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="1"
            android:textColor="@color/White"
            android:textSize="@dimen/text_smaller"
            android:textStyle="bold" />
    </FrameLayout>


    <ImageView
        android:id="@+id/unselect_service"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="right|top"
        android:paddingRight="@dimen/horizontal_margin_third"
        android:paddingTop="@dimen/horizontal_margin_third"
        android:paddingBottom="@dimen/horizontal_margin_half"
        android:paddingLeft="@dimen/horizontal_margin_half"
        android:src="@drawable/ic_exit" />

</FrameLayout>
