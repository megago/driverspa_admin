<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingBottom="@dimen/vertical_margin">

    <TextView
        android:id="@+id/txtWasherNameTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="@dimen/horizontal_margin"
        android:layout_marginRight="@dimen/horizontal_margin"
        android:gravity="center"
        android:text="Тап таза автомойка"
        android:textColor="@color/White"
        android:textSize="@dimen/text_medium" />



    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingBottom="@dimen/vertical_margin">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:background="@color/BlueTransparent"></FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:paddingLeft="@dimen/horizontal_margin_half"
                android:text="Выберите автомобиль:"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:layout_marginLeft="@dimen/horizontal_margin_half"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:textColor="@color/White"
                android:textColorHint="@color/BlueLight"
                android:textIsSelectable="false"
                android:textSize="@dimen/text_normal" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/vertical_margin">

                <com.driverspa.view.ExpandableGridView
                    android:id="@+id/grid_cars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:horizontalSpacing="5dp"
                    android:isScrollContainer="false"
                    android:numColumns="auto_fit"
                    android:listSelector="@android:color/transparent"
                    android:padding="1dp"
                    android:stretchMode="none"
                    android:verticalSpacing="5dp" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:layout_marginTop="@dimen/vertical_margin"
                android:background="@color/BlueTransparent"></FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:paddingLeft="@dimen/horizontal_margin_half"
                android:text="Выберите услуги:"
                android:layout_marginLeft="@dimen/horizontal_margin_half"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:textColor="@color/White"
                android:textColorHint="@color/BlueLight"
                android:textIsSelectable="false"
                android:textSize="@dimen/text_normal" />


            <com.driverspa.view.ExpandableGridView
                    android:id="@+id/grid_services"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:visibility="gone"
                    android:horizontalSpacing="5dp"
                    android:layout_marginTop="@dimen/vertical_margin"
                    android:isScrollContainer="false"
                    android:listSelector="@android:color/transparent"
                    android:numColumns="auto_fit"
                    android:padding="1dp"
                    android:stretchMode="none"
                    android:verticalSpacing="5dp" />

            <TextView
                android:id="@+id/no_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:paddingLeft="@dimen/horizontal_margin_half"
                android:text="Нет доступных услуг"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:textColor="@color/White"
                android:textColorHint="@color/BlueLight"
                android:textIsSelectable="false"
                android:textSize="@dimen/text_normal" />


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:background="@color/BlueTransparent"></FrameLayout>


            <TextView
                android:id="@+id/txtTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:gravity="center"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:paddingLeft="@dimen/horizontal_margin_half"
                android:text="Время мойки: 0 мин"
                android:textColor="@color/White"
                android:textSize="@dimen/text_normal" />

            <TextView
                android:id="@+id/txtPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_marginBottom="@dimen/vertical_margin_half"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:gravity="center"
                android:paddingLeft="@dimen/horizontal_margin_half"
                android:text="Цена: 0 ₸"
                android:textColor="@color/White"
                android:textSize="@dimen/text_normal"
                android:textStyle="bold" />


            <Button
                android:id="@+id/btnBookNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/vertical_margin_double"
                android:background="@drawable/background_button_border"
                android:paddingBottom="10dp"
                android:paddingLeft="40dp"
                android:paddingRight="40dp"
                android:paddingTop="10dp"
                android:text="Выбрать время"
                android:textColor="@drawable/button_state_color"
                android:textSize="@dimen/text_normal" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
