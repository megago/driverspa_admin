<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- "Use my location" (GPS) row -->
    <LinearLayout
        android:id="@+id/currentLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_gps_24dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/myLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/my_location"
                android:textColor="@color/White"
                android:textIsSelectable="false"
                android:textSize="@dimen/text_normal"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/detect_city_gps"
                android:textColor="@color/BlueLight"
                android:textSize="@dimen/text_smaller" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_v2_check_circle" />

            <ImageView
                android:id="@+id/myLocationCheckbox"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_v2_check_circle_filled"
                android:padding="3dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_checkmark"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Divider between "my location" and the city list -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#15FFFFFF" />

    <!-- Section label -->
    <LinearLayout
        android:id="@+id/txtLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.08"
            android:text="@string/choose_city_caps"
            android:textColor="@color/BlueLight"
            android:textSize="@dimen/text_smaller"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
