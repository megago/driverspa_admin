<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@drawable/gradient_bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/vertical_margin"
        android:layout_marginLeft="@dimen/horizontal_margin"
        android:layout_marginRight="@dimen/horizontal_margin"
        android:gravity="center"
        android:text="Добавление акции"
        android:textColor="@color/White"
        android:textSize="@dimen/text_normal"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingBottom="@dimen/vertical_margin">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|left"
                android:paddingLeft="@dimen/horizontal_margin"
                android:gravity="left"
                android:background="#50000000"
                android:paddingBottom="@dimen/vertical_margin_third"
                android:paddingTop="@dimen/vertical_margin_third"
                android:text="Краткое описание акции (100 символов)"
                android:textColor="@color/White"
                android:textSize="@dimen/text_normal" />

            <EditText
                android:id="@+id/description"
                style="@style/EditText.Transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_third"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:maxLength="100"
                android:imeOptions="actionNext"
                android:inputType="text|textMultiLine|textCapSentences"
                android:gravity="top|left"
                android:text=""
                android:hint="Описание"
                android:textColor="@color/White"
                android:textColorHint="@color/actionbar_color"
                android:textCursorDrawable="@null"
                android:textIsSelectable="false"
                android:textSize="@dimen/text_normal" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:visibility="gone"
                android:background="@color/BlueTransparent"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|left"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:paddingLeft="@dimen/horizontal_margin"
                android:gravity="left"
                android:paddingBottom="@dimen/vertical_margin_third"
                android:paddingTop="@dimen/vertical_margin_third"
                android:text="Дата окончания акции(включительно)"
                android:background="#50000000"
                android:textColor="@color/White"
                android:textSize="@dimen/text_normal" />


            <TextView
                android:id="@+id/endDate"
                style="@style/EditText.Transparent"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_third"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:hint="Дата окончания"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:text=""
                android:textColor="@color/White"
                android:textColorHint="@color/actionbar_color"
                android:textCursorDrawable="@null"
                android:textIsSelectable="false"
                android:textSize="@dimen/text_normal" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:visibility="gone"
                android:background="@color/BlueTransparent"></FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:paddingLeft="@dimen/horizontal_margin"
                android:gravity="left"
                android:layout_marginTop="@dimen/vertical_margin_third"
                android:paddingBottom="@dimen/vertical_margin_third"
                android:paddingTop="@dimen/vertical_margin_third"
                android:background="#50000000"
                android:text="Скидка"
                android:textColor="@color/White"
                android:textSize="@dimen/text_normal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|left"
                    android:layout_marginLeft="@dimen/horizontal_margin_half"
                    android:gravity="center"
                    android:paddingBottom="@dimen/vertical_margin_third"
                    android:paddingTop="@dimen/vertical_margin_third"
                    android:text="Скидка:"
                    android:visibility="gone"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_normal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|left"
                    android:layout_marginLeft="@dimen/horizontal_margin_third"
                    android:gravity="center"
                    android:paddingBottom="@dimen/vertical_margin_half"
                    android:paddingTop="@dimen/vertical_margin_half"
                    android:text="%"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_normal" />

                <EditText
                    android:id="@+id/discount"
                    style="@style/EditText.Transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/horizontal_margin_half"
                    android:padding="@dimen/vertical_margin_half"
                    android:gravity="left"
                    android:hint=""
                    android:inputType="number"
                    android:maxLength="2"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="0"
                    android:textColor="@color/White"
                    android:textColorHint="@color/actionbar_color"
                    android:textCursorDrawable="@null"
                    android:textSize="@dimen/text_normal"></EditText>


            </LinearLayout>


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:visibility="gone"
                android:background="@color/BlueTransparent"></FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:paddingLeft="@dimen/horizontal_margin"
                android:gravity="left"
                android:paddingBottom="@dimen/vertical_margin_third"
                android:paddingTop="@dimen/vertical_margin_third"
                android:background="#50000000"
                android:text="Распространяется:"
                android:textColor="@color/White"
                android:textSize="@dimen/text_normal" />

            <LinearLayout
                android:id="@+id/both"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:visibility="gone"
                android:background="@drawable/background_list_item_buttons"
                android:clickable="true"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/vertical_margin_half"
                android:paddingTop="@dimen/vertical_margin_half">

                <TextView
                    android:id="@+id/txtBoth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="5"
                    android:paddingLeft="@dimen/horizontal_margin_half"
                    android:text="На все виды мойки"
                    android:textColor="@color/White"
                    android:textColorHint="@color/actionbar_color"
                    android:textIsSelectable="false"
                    android:textSize="@dimen/text_normal" />

                <ImageView
                    android:id="@+id/bothImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:src="@drawable/background_list_item_checkmark" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:visibility="gone"
                android:background="@color/BlueTransparent"></FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/offline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@drawable/background_list_item_buttons"
                    android:clickable="true"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:paddingBottom="@dimen/vertical_margin_half"
                    android:paddingTop="@dimen/vertical_margin_half">

                    <TextView
                        android:id="@+id/txtOffline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="5"
                        android:paddingLeft="@dimen/horizontal_margin_half"
                        android:text="Живая очередь"
                        android:textColor="@color/White"
                        android:textColorHint="@color/actionbar_color"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/text_normal" />

                    <ImageView
                        android:id="@+id/offlineImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:src="@drawable/background_list_item_checkmark" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:visibility="gone"
                    android:background="@color/BlueTransparent"></FrameLayout>

                <LinearLayout
                    android:id="@+id/online"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@drawable/background_list_item_buttons"
                    android:clickable="true"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/vertical_margin_half"
                    android:paddingTop="@dimen/vertical_margin_half">

                    <TextView
                        android:id="@+id/txtOnline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="5"
                        android:paddingLeft="@dimen/horizontal_margin_half"
                        android:text="Онлайн бронирование"
                        android:textColor="@color/White"
                        android:textColorHint="@color/actionbar_color"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/text_normal" />

                    <ImageView
                        android:id="@+id/onlineImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:src="@drawable/background_list_item_checkmark" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@color/BlueTransparent"></FrameLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btnBook"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/vertical_margin"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:layout_marginTop="@dimen/vertical_margin_double"
                android:background="@drawable/background_button_border"
                android:paddingBottom="5dp"
                android:visibility="gone"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="10dp"
                android:text="Добавить акцию"
                android:textColor="@drawable/button_state_color"
                android:textSize="@dimen/text_normal" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>