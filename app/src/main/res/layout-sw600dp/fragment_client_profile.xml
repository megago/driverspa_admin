<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/vertical_margin"
        android:layout_marginLeft="@dimen/horizontal_margin"
        android:layout_marginRight="@dimen/horizontal_margin"
        android:layout_weight="0.5"
        android:visibility="gone"
        android:gravity="center"
        android:text="@string/profile_title"
        android:textColor="@color/White"
        android:textSize="@dimen/text_normal" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="7" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingBottom="@dimen/vertical_margin" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical" >

                <FrameLayout
                    android:layout_width="@dimen/washer_profile_view_width"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">
                    <com.driverspa.view.ImageViewSquared
                        android:id="@+id/imgClientAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"/>
                    <ImageView
                        android:id="@+id/images_circle"
                        android:visibility="gone"
                        android:layout_width="@dimen/washer_profile_view_width"
                        android:layout_height="@dimen/washer_profile_view_width"
                        android:src="@drawable/ic_circle_new_message"/>
                    <FrameLayout
                        android:id="@+id/images_count_rect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ic_rectangle_new_message"
                        android:layout_gravity="right|center"
                        android:visibility="gone"
                        android:layout_marginRight="@dimen/horizontal_margin_third"
                        android:layout_marginTop="@dimen/vertical_margin_double">
                        <TextView
                            android:id="@+id/images_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12"
                            android:textColor="@color/White"
                            android:textSize="@dimen/text_normal"
                            android:layout_gravity="center"/>
                    </FrameLayout>
                </FrameLayout>

                <EditText
                    android:id="@+id/clientName"
                    style="@style/EditText.Transparent"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:layout_marginTop="@dimen/vertical_margin_half"
                    android:hint="@string/name_label"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:textColor="@color/White"
                    android:textColorHint="@color/BlueLight"
                    android:textCursorDrawable="@null"
                    android:textIsSelectable="false"
                    android:textSize="@dimen/text_normal" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:layout_marginTop="@dimen/vertical_margin_half"
                    android:background="@color/BlueTransparent" >
                </FrameLayout>

                <TextView
                    android:id="@+id/txtPhoneNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:layout_marginTop="@dimen/vertical_margin_half"
                    android:paddingLeft="@dimen/horizontal_margin_half"
                    android:text="+7 707 674 4674"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_normal" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:layout_marginTop="@dimen/vertical_margin_half"
                    android:background="@color/BlueTransparent" >
                </FrameLayout>

                <com.driverspa.view.ExpandableGridView
                    android:id="@+id/grid_cars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:horizontalSpacing="5dp"
                    android:isScrollContainer="false"
                    android:layout_marginTop="@dimen/vertical_margin"
                    android:listSelector="@drawable/background_button_grid_item_cars"
                    android:numColumns="auto_fit"
                    android:padding="1dp"
                    android:stretchMode="none"
                    android:verticalSpacing="5dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:layout_marginTop="@dimen/vertical_margin"
                    android:background="@color/BlueTransparent"/>

                <LinearLayout
                    android:id="@+id/cityLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@drawable/background_list_item_buttons"
                    android:clickable="true"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/vertical_margin_half"
                    android:visibility="gone"
                    android:paddingTop="@dimen/vertical_margin_half" >

                    <TextView
                        android:id="@+id/txtCity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="5"
                        android:text="@string/city"
                        android:paddingLeft="@dimen/horizontal_margin_half"
                        android:textColor="@color/White"
                        android:textColorHint="@color/BlueLight"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/text_normal" />

                    <ImageView
                        android:id="@+id/imageView6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:visibility="invisible"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:visibility="gone"
                    android:background="@color/BlueTransparent"/>

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/vertical_margin_double"
                    android:background="@drawable/background_button_border"
                    android:padding="10dp"
                    android:text="@string/save"
                    android:textColor="@drawable/button_state_color"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>


</LinearLayout>
