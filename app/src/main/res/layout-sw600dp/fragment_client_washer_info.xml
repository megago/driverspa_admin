<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="@dimen/vertical_margin">

        <TextView
            android:id="@+id/txtWasherNameTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/vertical_margin"
            android:layout_marginLeft="@dimen/horizontal_margin"
            android:layout_marginRight="@dimen/horizontal_margin"
            android:gravity="center"
            android:text="@string/textview_loading_data"
            android:textColor="@color/White"
            android:textSize="@dimen/text_medium" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingBottom="@dimen/vertical_margin">

                <Button
                    android:id="@+id/btnBookStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/background_button_border"
                    android:paddingBottom="10dp"
                    android:paddingLeft="40dp"
                    android:paddingRight="40dp"
                    android:paddingTop="10dp"
                    android:text="ЗАБРОНИРОВАТЬ"
                    android:textColor="@drawable/button_state_color"
                    android:textSize="@dimen/text_normal" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dip"
                    android:layout_marginBottom="10dip"
                    android:layout_marginTop="@dimen/vertical_margin"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:padding="1dip">

                    <fragment
                        android:id="@+id/mapThis"
                        android:name="com.google.android.gms.maps.SupportMapFragment"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        tools:context="com.driverspa.client.activity.ClientWasherInfoActivity" />
                </FrameLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vertical_margin_half">

                    <FrameLayout
                        android:id="@+id/imgWasherAvatarLayout"
                        android:layout_width="@dimen/washer_profile_view_width"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentTop="true"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/horizontal_margin">

                        <com.driverspa.view.ImageViewSquared
                            android:id="@+id/imgWasherAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true" />

                        <ImageView
                            android:id="@+id/images_circle"
                            android:layout_width="@dimen/washer_profile_view_width"
                            android:layout_height="@dimen/washer_profile_view_width"
                            android:src="@drawable/ic_circle_new_message"
                            android:visibility="gone" />

                        <FrameLayout
                            android:id="@+id/images_count_rect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="right|center"
                            android:layout_marginRight="@dimen/horizontal_margin_third"
                            android:layout_marginTop="@dimen/vertical_margin_double"
                            android:background="@drawable/ic_rectangle_new_message"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/images_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="12"
                                android:textColor="@color/White"
                                android:textSize="@dimen/text_normal" />
                        </FrameLayout>
                    </FrameLayout>


                    <!--<com.driverspa.view.ImageViewSquared-->
                    <!--android:id="@+id/imgWasherAvatar"-->
                    <!--android:layout_width="@dimen/washer_profile_view_width"-->
                    <!--android:layout_height="wrap_content"-->
                    <!--android:layout_alignParentLeft="true"-->
                    <!--android:layout_alignParentTop="true"-->
                    <!--android:layout_marginLeft="@dimen/horizontal_margin"-->
                    <!--android:clickable="true" />-->

                    <TextView
                        android:id="@+id/txtWasherName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_toRightOf="@+id/imgWasherAvatarLayout"
                        android:text="@string/textview_loading_data"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_small"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtWasherAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/txtWasherName"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_toRightOf="@+id/imgWasherAvatarLayout"
                        android:text="@string/textview_loading_data"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_small" />

                    <LinearLayout
                        android:id="@+id/layoutEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtWasherAddress"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_toRightOf="@+id/imgWasherAvatarLayout"
                        android:layout_marginTop="@dimen/margin_2dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="E-mail:"
                            android:textColor="@color/White"
                            android:textSize="@dimen/text_small" />

                        <TextView
                            android:id="@+id/txtWasherEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/horizontal_margin_third"
                            android:autoLink="email"
                            android:text="@string/textview_loading_data"
                            android:textColor="@color/White"
                            android:textSize="@dimen/text_small" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutWeb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/layoutEmail"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginTop="@dimen/margin_2dp"
                        android:layout_toRightOf="@+id/imgWasherAvatarLayout"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Веб:"
                            android:textColor="@color/White"
                            android:textSize="@dimen/text_small" />

                        <TextView
                            android:id="@+id/txtWasherWeb"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/horizontal_margin_third"
                            android:autoLink="web"
                            android:text="@string/textview_loading_data"
                            android:textColor="@color/White"
                            android:textSize="@dimen/text_small" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/layoutWeb"
                        android:layout_marginTop="@dimen/margin_2dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_toRightOf="@+id/imgWasherAvatarLayout">

                        <ImageView
                            android:id="@+id/imageView2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="2dp"
                            android:src="@drawable/ic_phone" />

                        <TextView
                            android:id="@+id/txtWasherPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/horizontal_margin_third"
                            android:clickable="true"
                            android:text="@string/textview_loading_data"
                            android:textColor="@color/White"
                            android:textColorLink="@color/White"
                            android:textSize="@dimen/text_small" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/layoutPhone"
                        android:layout_marginTop="@dimen/margin_2dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:layout_toRightOf="@+id/imgWasherAvatarLayout">

                        <ImageView
                            android:id="@+id/imageView3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginLeft="2dp"
                            android:layout_gravity="top"
                            android:src="@drawable/ic_time" />

                        <TextView
                            android:id="@+id/txtWasherTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/horizontal_margin_third"
                            android:layout_gravity="center"
                            android:text="@string/textview_loading_data"
                            android:textColor="@color/White"
                            android:textSize="@dimen/text_small" />
                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/layoutExtra"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/layoutTime"
                        android:layout_marginTop="@dimen/margin_2dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_toRightOf="@+id/imgWasherAvatarLayout"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/addInfoView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"/>
                        <TextView
                            android:id="@+id/txtExtraServices"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/horizontal_margin_third"
                            android:text="Wifi"
                            android:textColor="@color/White"
                            android:textSize="@dimen/text_small" />
                        <LinearLayout
                            android:id="@+id/layoutWifi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/horizontal_margin_half"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/imageView4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginLeft="2dp"
                                android:src="@drawable/ic_wifi" />

                            <TextView
                                android:id="@+id/txtWasherWifi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/horizontal_margin_third"
                                android:text="Wifi"
                                android:textColor="@color/White"
                                android:textSize="@dimen/text_small" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutKafe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left"
                            android:gravity="left"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/imageView5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginLeft="2dp"
                                android:src="@drawable/ic_cafe" />

                            <TextView
                                android:id="@+id/txtWasherKafe"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/horizontal_margin_third"
                                android:text="Кафе"
                                android:textColor="@color/White"
                                android:textSize="@dimen/text_small" />
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:layout_marginTop="@dimen/vertical_margin"
                    android:background="@color/BlueTransparent"></FrameLayout>

                <LinearLayout
                    android:id="@+id/favouriteLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@drawable/background_list_item_buttons"
                    android:clickable="true"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/vertical_margin_half"
                    android:paddingTop="@dimen/vertical_margin_half">

                    <ImageView
                        android:id="@+id/imgFavourite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:paddingRight="@dimen/horizontal_margin_half"
                        android:src="@drawable/background_image_favourite" />

                    <TextView
                        android:id="@+id/txtWasherFavourite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/horizontal_margin_half"
                        android:text="В избранное"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_normal" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@color/BlueTransparent"></FrameLayout>

                <LinearLayout
                    android:id="@+id/priceLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@drawable/background_list_item_buttons"
                    android:clickable="true"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/vertical_margin_half"
                    android:paddingTop="@dimen/vertical_margin_half">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/horizontal_margin_third"
                        android:paddingRight="@dimen/horizontal_margin_half"
                        android:src="@drawable/ic_price" />

                    <TextView
                        android:id="@+id/txtWasherPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/horizontal_margin_five"
                        android:text="Цены"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_normal" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@color/BlueTransparent"></FrameLayout>

                <LinearLayout
                    android:id="@+id/reviewLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@drawable/background_list_item_buttons"
                    android:clickable="true"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/vertical_margin_half"
                    android:paddingTop="@dimen/vertical_margin_half">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/horizontal_margin_third"
                        android:paddingRight="@dimen/horizontal_margin_half"
                        android:src="@drawable/ic_report" />

                    <TextView
                        android:id="@+id/txtWasherReview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/horizontal_margin_six"
                        android:text="Отзывы"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_normal" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:visibility="gone"
                    android:background="@color/BlueTransparent"></FrameLayout>

                <LinearLayout
                    android:id="@+id/timeTableLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@drawable/background_list_item_buttons"
                    android:clickable="true"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/vertical_margin_half"
                    android:paddingTop="@dimen/vertical_margin_half">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/horizontal_margin_third"
                        android:paddingRight="@dimen/horizontal_margin_half"
                        android:src="@drawable/ic_grid" />

                    <TextView
                        android:id="@+id/txtTimeTable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/horizontal_margin_half"
                        android:text="Расписание"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_normal" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@color/BlueTransparent"></FrameLayout>

                <Button
                    android:id="@+id/btnBookStart2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/vertical_margin_double"
                    android:background="@drawable/background_button_border"
                    android:paddingBottom="10dp"
                    android:paddingLeft="40dp"
                    android:paddingRight="40dp"
                    android:paddingTop="10dp"
                    android:text="ЗАБРОНИРОВАТЬ"
                    android:textColor="@drawable/button_state_color"
                    android:textSize="@dimen/text_normal" />
            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <ImageButton
        android:id="@+id/OkBt"
        style="@style/AppTheme"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|right"
        android:layout_marginBottom="@dimen/vertical_margin"
        android:layout_marginRight="@dimen/horizontal_margin"
        android:background="@drawable/circle"
        android:elevation="10dp"
        android:src="@drawable/ic_add_white_18dp"
        android:text="New Button"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/btnCall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|right"
        android:layout_marginBottom="@dimen/vertical_margin_double"
        android:layout_marginRight="@dimen/horizontal_margin"
        android:visibility="gone"
        android:background="@drawable/background_green_button_oval">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="3dp"
            android:src="@drawable/ic_phone_material" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|right"
        android:layout_marginBottom="@dimen/vertical_margin_double"
        android:layout_marginRight="@dimen/horizontal_margin"
        android:visibility="gone"
        android:background="@drawable/background_green_button_oval">
        <ImageView
            android:id="@+id/buttonBook"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginBottom="2dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_timer_white_24dp" />
    </FrameLayout>
</FrameLayout>