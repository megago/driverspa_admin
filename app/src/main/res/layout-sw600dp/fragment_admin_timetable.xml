<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnToday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="@null"
                android:clickable="true"
                android:gravity="center"
                android:text="СЕГОДНЯ"
                android:textColor="@drawable/button_bar_state_color"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTomorrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="@null"
                android:clickable="true"
                android:gravity="center"
                android:text="ЗАВТРА"
                android:textColor="@drawable/button_bar_state_color"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/vertical_margin_third"
            android:visibility="gone"
            android:background="@color/BlueTransparent" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#55000000"
            android:layout_gravity="bottom"
            android:gravity="center">

            <Gallery
                android:id="@+id/tabView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:gravity="center" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/vertical_margin">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <com.driverspa.view.ExpandableGridView
                            android:id="@+id/gridView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:adjustViewBounds="true"
                            android:background="@drawable/background_button_grid"
                            android:horizontalSpacing="0dp"
                            android:isScrollContainer="false"
                            android:numColumns="auto_fit"
                            android:padding="1dp"
                            android:stretchMode="none"
                            android:verticalSpacing="0dp" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtNoTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="@dimen/vertical_margin"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:layout_marginTop="@dimen/vertical_margin"
                        android:gravity="center"
                        android:text="Бронь не может быть продолжен. Нет данных на сегодня, или произошла ошибка при получении график работы мойки"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_medium"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnRepeat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/vertical_margin"
                        android:background="@drawable/background_button_border"
                        android:padding="10dp"
                        android:text="@string/retry"
                        android:textColor="@drawable/button_state_color"
                        android:textSize="22sp"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/bookBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="bottom|right"
        android:layout_marginBottom="@dimen/vertical_margin_half"
        android:layout_marginRight="@dimen/horizontal_margin"
        android:background="@drawable/background_green_button_oval">
        <ImageView
            android:id="@+id/buttonBook"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginBottom="2dp"
            android:layout_marginRight="1dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_timer_white_24dp" />
    </FrameLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/forwardButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|right"
        android:layout_marginBottom="140dp"
        android:layout_marginRight="20dp"
        android:src="@drawable/ic_forward_timetable"
        app:backgroundTint="@color/BlueTransparent2"
        android:tint="@android:color/transparent"
        android:visibility="gone"
        app:fabSize="normal" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/rewardButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_marginBottom="140dp"
        android:layout_marginLeft="20dp"
        android:src="@drawable/ic_reward_timetable"
        app:backgroundTint="@color/BlueTransparent2"
        android:tint="@android:color/transparent"
        android:visibility="gone"
        app:fabSize="normal" />


</FrameLayout>