<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/parentView"
    android:paddingBottom="@dimen/vertical_margin_half"
    android:paddingTop="@dimen/vertical_margin_half" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:paddingLeft="@dimen/horizontal_margin"
        android:paddingRight="@dimen/horizontal_margin"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtBookTime"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="10:30"
                android:textColor="@color/White"
                android:textSize="@dimen/text_small" />

            <TextView
                android:id="@+id/txtBookTS"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="01.01.2016\n16:00"
                android:textColor="@color/Light"
                android:textSize="@dimen/text_small" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginLeft="@dimen/horizontal_margin_half"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtWasherName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:text="@string/wash"
                android:textColor="@color/White"
                android:textSize="@dimen/text_small" />
            <TextView
                android:id="@+id/txtBookKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:text="@string/car_number_example"
                android:textColor="@color/White"
                android:textSize="@dimen/text_small" />

            <TextView
                android:id="@+id/txtBookStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:text="@string/finished"
                android:textColor="@color/Light"
                android:textSize="@dimen/text_small" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/imageView1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="@dimen/horizontal_margin_third"
        android:paddingRight="@dimen/horizontal_margin"
        android:src="@drawable/ic_arrow_right" />

</RelativeLayout>