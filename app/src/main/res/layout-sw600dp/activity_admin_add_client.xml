<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar_actionbar"
        layout="@layout/toolbar_admin_detail_activity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:orientation="vertical"
                android:paddingBottom="@dimen/vertical_margin">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|left"
                    android:background="#50000000"
                    android:gravity="left"
                    android:paddingBottom="@dimen/vertical_margin_third"
                    android:paddingLeft="@dimen/horizontal_margin"
                    android:paddingTop="@dimen/vertical_margin_third"
                    android:text="ФИО"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_normal" />

                <EditText
                    android:id="@+id/clientName"
                    style="@style/EditText.Transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/vertical_margin_third"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:layout_marginTop="@dimen/vertical_margin_third"
                    android:gravity="top|left"
                    android:hint="ФИО"
                    android:imeOptions="actionNext"
                    android:inputType="text|textMultiLine|textCapSentences"
                    android:lines="1"
                    android:maxLength="100"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/White"
                    android:textColorHint="@color/actionbar_color"
                    android:textCursorDrawable="@null"
                    android:textIsSelectable="false"
                    android:textSize="@dimen/text_normal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|left"
                    android:background="#50000000"
                    android:gravity="left"
                    android:paddingBottom="@dimen/vertical_margin_third"
                    android:paddingLeft="@dimen/horizontal_margin"
                    android:paddingTop="@dimen/vertical_margin_third"
                    android:text="Номер телефона"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_normal" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/vertical_margin_third"
                    android:layout_marginTop="@dimen/vertical_margin_half"
                    android:orientation="horizontal">

                    <!--<com.google.android.material.textfield.TextInputLayout
            app:defaultHintTextColor="@color/actionbar_color"
            app:hintTextColor="@color/actionbar_color"-->
                    <!--android:id="@+id/mobileNoWrapper"-->
                    <!--android:layout_width="match_parent"-->
                    <!--android:layout_height="wrap_content"-->
                    <!--android:layout_marginLeft="@dimen/horizontal_margin"-->
                    <!--android:layout_marginRight="@dimen/horizontal_margin">-->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:paddingLeft="@dimen/horizontal_margin_half"
                        android:text="+7"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_small" />

                    <EditText
                        android:id="@+id/phone"
                        style="@style/EditText.Transparent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="(***) ___ __-__"
                        android:imeOptions="actionNext"
                        android:inputType="phone"
                        android:textColor="@color/White"
                        android:textColorHint="@color/actionbar_color"
                        android:textCursorDrawable="@null"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/text_small" />
                    <!--</com.google.android.material.textfield.TextInputLayout>-->
                </LinearLayout>

                <!--<TextView-->
                <!--android:layout_width="match_parent"-->
                <!--android:layout_height="wrap_content"-->
                <!--android:layout_gravity="bottom|left"-->
                <!--android:background="#50000000"-->
                <!--android:gravity="left"-->
                <!--android:paddingBottom="@dimen/vertical_margin_third"-->
                <!--android:paddingLeft="@dimen/horizontal_margin"-->
                <!--android:paddingTop="@dimen/vertical_margin_third"-->
                <!--android:text="Пол"-->
                <!--android:textColor="@color/White"-->
                <!--android:textSize="@dimen/text_normal" />-->

                <!--<com.driverspa.view.NDSpinner-->
                <!--android:id="@+id/spinner"-->
                <!--android:layout_width="wrap_content"-->
                <!--android:layout_height="wrap_content"-->
                <!--android:layout_gravity="center|left"-->
                <!--android:layout_marginBottom="@dimen/vertical_margin_third"-->
                <!--android:layout_marginLeft="@dimen/horizontal_margin"-->
                <!--android:layout_marginTop="@dimen/vertical_margin_third"-->
                <!--android:clickable="true"-->
                <!--android:drawSelectorOnTop="true"-->
                <!--android:entries="@array/newsTarget"-->
                <!--android:popupBackground="@color/spinner_popup_background"-->
                <!--android:spinnerMode="dropdown"-->
                <!--android:textColor="@drawable/button_state_color"-->
                <!--android:textCursorDrawable="@null"-->
                <!--android:textSize="@dimen/text_normal" />-->


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|left"
                    android:background="#50000000"
                    android:gravity="left"
                    android:paddingBottom="@dimen/vertical_margin_third"
                    android:paddingLeft="@dimen/horizontal_margin"
                    android:paddingTop="@dimen/vertical_margin_third"
                    android:text="Дата рождения"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_normal"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/birthDate"
                    style="@style/EditText.Transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/vertical_margin_third"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:layout_marginTop="@dimen/vertical_margin_third"
                    android:gravity="top|left"
                    android:hint="Дата рождения"
                    android:imeOptions="actionNext"
                    android:inputType="text|textMultiLine|textCapSentences"
                    android:lines="1"
                    android:maxLength="100"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/White"
                    android:textColorHint="@color/actionbar_color"
                    android:textCursorDrawable="@null"
                    android:textIsSelectable="false"
                    android:textSize="@dimen/text_normal"
                    android:visibility="gone" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|left"
                    android:background="#50000000"
                    android:gravity="left"
                    android:paddingBottom="@dimen/vertical_margin_third"
                    android:paddingLeft="@dimen/horizontal_margin"
                    android:paddingTop="@dimen/vertical_margin_third"
                    android:text="Скидка %"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_normal" />

                <EditText
                    android:id="@+id/discount"
                    style="@style/EditText.Transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/vertical_margin_third"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:layout_marginTop="@dimen/vertical_margin_third"
                    android:gravity="top|left"
                    android:hint="Скидка %"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:lines="1"
                    android:maxLength="3"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/White"
                    android:textColorHint="@color/actionbar_color"
                    android:textCursorDrawable="@null"
                    android:textIsSelectable="false"
                    android:textSize="@dimen/text_normal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|left"
                    android:background="#50000000"
                    android:gravity="left"
                    android:paddingBottom="@dimen/vertical_margin_third"
                    android:paddingLeft="@dimen/horizontal_margin"
                    android:paddingTop="@dimen/vertical_margin_third"
                    android:text="Бонус %"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_normal" />

                <EditText
                    android:id="@+id/bonusPercentage"
                    style="@style/EditText.Transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/vertical_margin_third"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:layout_marginTop="@dimen/vertical_margin_third"
                    android:gravity="top|left"
                    android:hint="Процент начисления бонусов"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:lines="1"
                    android:maxLength="3"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/White"
                    android:textColorHint="@color/actionbar_color"
                    android:textCursorDrawable="@null"
                    android:textIsSelectable="false"
                    android:textSize="@dimen/text_normal" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|left"
                    android:background="#50000000"
                    android:gravity="left"
                    android:paddingBottom="@dimen/vertical_margin_third"
                    android:paddingLeft="@dimen/horizontal_margin"
                    android:paddingTop="@dimen/vertical_margin_third"
                    android:text="Запретить начисление бонусов"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_normal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@drawable/background_list_item_buttons"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/paid_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="5"
                        android:paddingBottom="@dimen/vertical_margin_half"
                        android:paddingTop="@dimen/vertical_margin_half"
                        android:text="Запретить начисление бонусов"
                        android:textColor="@drawable/button_state_color"
                        android:textColorHint="@color/actionbar_color"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/text_normal"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="0dip"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_weight="0.4"
                        android:gravity="center|left"
                        android:paddingBottom="@dimen/vertical_margin_half"
                        android:paddingTop="@dimen/vertical_margin_half">

                        <CheckBox
                            android:id="@+id/disableBonusAccrual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:button="@drawable/background_checkbox"
                            android:checked="true"
                            android:gravity="left|center"
                            android:padding="0dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|left"
                    android:background="#50000000"
                    android:gravity="left"
                    android:paddingBottom="@dimen/vertical_margin_third"
                    android:paddingLeft="@dimen/horizontal_margin"
                    android:paddingTop="@dimen/vertical_margin_third"
                    android:text="Машины клиента"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_normal" />

                <com.driverspa.view.ExpandableGridView
                    android:id="@+id/grid_cars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/vertical_margin"
                    android:adjustViewBounds="true"
                    android:horizontalSpacing="5dp"
                    android:isScrollContainer="false"
                    android:listSelector="@drawable/background_button_grid_item_cars"
                    android:numColumns="auto_fit"
                    android:padding="1dp"
                    android:stretchMode="none"
                    android:verticalSpacing="5dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:layout_marginTop="@dimen/vertical_margin_half"
                    android:background="@color/BlueTransparent"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="@dimen/vertical_margin"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:layout_marginTop="@dimen/vertical_margin_double"
                    android:background="@drawable/background_button_border"
                    android:paddingBottom="5dp"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:paddingTop="5dp"
                    android:text="Сохранить"
                    android:textColor="@drawable/button_state_color"
                    android:textSize="@dimen/text_normal" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
