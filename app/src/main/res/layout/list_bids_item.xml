<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:focusable="false">

    <RelativeLayout
        android:id="@+id/mainInfoLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/horizontal_margin"
        android:layout_marginRight="@dimen/horizontal_margin"
        android:background="@drawable/rounded_rectangle_white">

        <FrameLayout
            android:id="@+id/seekBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:background="@drawable/button_green_drawable_normal">
            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:progressDrawable="@drawable/custom_seek_bar"
                android:thumb="@android:color/transparent" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/reviewLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/seekBarLayout"
            android:layout_marginLeft="@dimen/horizontal_margin_half"
            android:layout_marginTop="@dimen/vertical_margin_third"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <RatingBar
                    android:id="@+id/review"
                    android:layout_width="wrap_content"
                    android:layout_height="12dp"
                    android:layout_gravity="center|left"
                    android:clickable="false"
                    android:focusable="false"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:progressDrawable="@drawable/custom_ratingbar_map_selector"
                    android:rating="3.0"
                    android:stepSize="0.2" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginRight="@dimen/horizontal_margin_half"
                android:gravity="right|top"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_distance" />

                <TextView
                    android:id="@+id/txtDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:text="3 km"
                    android:textColor="@color/Gray"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/txtLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/reviewLayout"
            android:layout_marginLeft="@dimen/horizontal_margin_half"
            android:layout_marginRight="@dimen/horizontal_margin_double"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtWasherName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/car_wash_label_sp"
                android:textColor="@color/Black"
                android:textSize="@dimen/text_normal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/addressLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtLayout"
            android:layout_marginLeft="@dimen/horizontal_margin_half"
            android:layout_marginRight="@dimen/horizontal_margin_double"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtWasherAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtLayout"
                android:layout_gravity="top"
                android:layout_weight="1"
                android:gravity="left|top"
                android:text="Address"
                android:textColor="@color/Black"
                android:textSize="@dimen/text_small" />
        </LinearLayout>

        <ImageView
            android:id="@+id/cancelBid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_below="@id/addressLayout"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="2dp"
            android:padding="@dimen/horizontal_margin"
            android:src="@drawable/ic_cancel_red" />

        <Button
            android:id="@+id/btnAcceptBid"
            android:layout_width="200dp"
            android:layout_height="45dp"
            android:layout_below="@id/addressLayout"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/vertical_margin_half"
            android:layout_marginLeft="@dimen/horizontal_margin_half"
            android:layout_marginRight="@dimen/horizontal_margin_double"
            android:layout_marginTop="@dimen/vertical_margin_half"
            android:layout_toLeftOf="@id/cancelBid"
            android:background="@drawable/background_green_button"
            android:padding="10dp"
            android:paddingLeft="@dimen/horizontal_margin_double"
            android:paddingRight="@dimen/horizontal_margin"
            android:text="@string/accept_1000"
            android:textAllCaps="false"
            android:textColor="@color/White"
            android:textSize="@dimen/text_normal" />
    </RelativeLayout>

</RelativeLayout>