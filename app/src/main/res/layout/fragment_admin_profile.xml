<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="7">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:orientation="vertical"
                android:paddingBottom="@dimen/vertical_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="@dimen/vertical_margin"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:layout_weight="0.5"
                        android:gravity="center"
                        android:text="Профайл"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_normal"
                        android:visibility="gone" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/profile_avatar_invisible"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            />

                        <FrameLayout
                            android:id="@+id/fade_for_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            android:background="#D9257165"
                            />

                        <FrameLayout
                        android:layout_width="@dimen/washer_profile_view_width"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center">

                        <com.driverspa.view.ImageViewSquared
                            android:id="@+id/company_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true" />

                            <ImageView
                                android:id="@+id/images_circle"
                                android:visibility="gone"
                                android:layout_width="@dimen/washer_profile_view_width"
                                android:layout_height="@dimen/washer_profile_view_width"
                                android:src="@drawable/ic_circle_new_message"/>

                        <FrameLayout
                            android:id="@+id/images_count_rect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="right|center"
                            android:layout_marginRight="@dimen/horizontal_margin_third"
                            android:layout_marginTop="@dimen/vertical_margin_double"
                            android:background="@drawable/ic_rectangle_new_message"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/images_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="12"
                                android:textColor="@color/White"
                                android:textSize="@dimen/text_normal" />
                        </FrameLayout>
                    </FrameLayout>
                    </FrameLayout>
                    <!--<com.driverspa.view.ImageViewSquared-->
                    <!--android:id="@+id/company_avatar"-->
                    <!--android:layout_width="@dimen/washer_profile_view_width"-->
                    <!--android:layout_height="wrap_content"-->
                    <!--android:layout_gravity="center"-->
                    <!--android:clickable="true" />-->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/mobileNoWrapper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        app:hintTextAppearance="@style/TextInputHint.BlueLight"
                        app:hintTextColor="@color/BlueLight">

                        <EditText
                            android:id="@+id/companyName"
                            style="@style/EditText.Transparent"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:hint="Название мойки"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:textColor="@color/AntiqueWhite"
                            android:textColorHint="@color/BlueLight"
                            android:textCursorDrawable="@null"
                            android:textIsSelectable="false"
                            android:textSize="@dimen/text_normal" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:layout_marginTop="@dimen/vertical_margin_half"
                        android:background="@color/BlueTransparent"></FrameLayout>

                    <LinearLayout
                        android:id="@+id/address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@drawable/background_list_item_buttons"
                        android:clickable="true"
                        android:orientation="horizontal"
                        android:paddingBottom="@dimen/vertical_margin_half"
                        android:paddingTop="@dimen/vertical_margin_half">

                        <TextView
                            android:id="@+id/txtAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:hint="Адрес"
                            android:paddingLeft="@dimen/horizontal_margin_half"
                            android:text="Адрес"
                            android:textColor="@color/White"
                            android:textColorHint="@color/BlueLight"
                            android:textIsSelectable="false"
                            android:textSize="@dimen/text_normal" />

                        <ImageView
                            android:id="@+id/imageView5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_arrow_right" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@color/BlueTransparent"></FrameLayout>

                    <LinearLayout
                        android:id="@+id/boxSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@drawable/background_list_item_buttons"
                        android:clickable="true"
                        android:orientation="horizontal"
                        android:paddingBottom="@dimen/vertical_margin_half"
                        android:paddingLeft="@dimen/horizontal_margin_half"
                        android:paddingTop="@dimen/vertical_margin_half">

                        <TextView
                            android:id="@+id/txtBoxesSettings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:text="Настройка боксов"
                            android:textColor="@color/White"
                            android:textColorHint="@color/BlueLight"
                            android:textIsSelectable="false"
                            android:textSize="@dimen/text_normal" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_arrow_right" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@color/BlueTransparent"
                        android:visibility="gone"></FrameLayout>

                    <LinearLayout
                        android:id="@+id/carType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@drawable/background_list_item_buttons"
                        android:clickable="true"
                        android:orientation="horizontal"
                        android:paddingBottom="@dimen/vertical_margin_half"
                        android:paddingTop="@dimen/vertical_margin_half"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/txtCarType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:paddingLeft="@dimen/horizontal_margin_half"
                            android:text="Типы машин"
                            android:textColor="@color/White"
                            android:textColorHint="@color/BlueLight"
                            android:textIsSelectable="false"
                            android:textSize="@dimen/text_normal" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_arrow_right" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@color/BlueTransparent"
                        android:visibility="gone"></FrameLayout>

                    <LinearLayout
                        android:id="@+id/services"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@drawable/background_list_item_buttons"
                        android:clickable="true"
                        android:orientation="horizontal"
                        android:paddingBottom="@dimen/vertical_margin_half"
                        android:paddingTop="@dimen/vertical_margin_half"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/txtServices"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:paddingLeft="@dimen/horizontal_margin_half"
                            android:text="Услуги"
                            android:textColor="@color/White"
                            android:textColorHint="@color/BlueLight"
                            android:textIsSelectable="false"
                            android:textSize="@dimen/text_normal" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_arrow_right" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@color/BlueTransparent"></FrameLayout>

                    <LinearLayout
                        android:id="@+id/prices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@drawable/background_list_item_buttons"
                        android:clickable="true"
                        android:orientation="horizontal"
                        android:paddingBottom="@dimen/vertical_margin_half"
                        android:paddingTop="@dimen/vertical_margin_half">

                        <TextView
                            android:id="@+id/txtPrices"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:paddingLeft="@dimen/horizontal_margin_half"
                            android:text="Услуги и цены"
                            android:textColor="@color/White"
                            android:textColorHint="@color/BlueLight"
                            android:textIsSelectable="false"
                            android:textSize="@dimen/text_normal" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_arrow_right" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:visibility="gone"
                        android:background="@color/BlueTransparent"></FrameLayout>

                    <LinearLayout
                        android:id="@+id/group_prices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@drawable/background_list_item_buttons"
                        android:clickable="true"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:paddingBottom="@dimen/vertical_margin_half"
                        android:paddingTop="@dimen/vertical_margin_half">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:paddingLeft="@dimen/horizontal_margin_half"
                            android:text="Комплексные услуги"
                            android:textColor="@color/White"
                            android:textColorHint="@color/BlueLight"
                            android:textIsSelectable="false"
                            android:textSize="@dimen/text_normal" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_arrow_right" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@color/BlueTransparent"
                        android:visibility="gone"></FrameLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@color/BlueTransparent"></FrameLayout>

                    <LinearLayout
                        android:id="@+id/time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@drawable/background_list_item_buttons"
                        android:clickable="true"
                        android:orientation="horizontal"
                        android:paddingBottom="@dimen/vertical_margin_half"
                        android:paddingTop="@dimen/vertical_margin_half">

                        <TextView
                            android:id="@+id/txtTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:paddingLeft="@dimen/horizontal_margin_half"
                            android:text="Время работы и доп. информация"
                            android:textColor="@color/White"
                            android:textColorHint="@color/BlueLight"
                            android:textIsSelectable="false"
                            android:textSize="@dimen/text_normal" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_arrow_right" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@color/BlueTransparent"></FrameLayout>

                    <LinearLayout
                        android:id="@+id/extran_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@drawable/background_list_item_buttons"
                        android:clickable="true"
                        android:orientation="horizontal"
                        android:paddingBottom="@dimen/vertical_margin_half"
                        android:paddingTop="@dimen/vertical_margin_half">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:paddingLeft="@dimen/horizontal_margin_half"
                            android:text="Дополнительные настройки"
                            android:textColor="@color/White"
                            android:textColorHint="@color/BlueLight"
                            android:textIsSelectable="false"
                            android:textSize="@dimen/text_normal" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_arrow_right" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/boxes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@drawable/background_list_item_buttons"
                        android:clickable="true"
                        android:orientation="horizontal"
                        android:paddingBottom="@dimen/vertical_margin_half"
                        android:paddingTop="@dimen/vertical_margin_half"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/txtBoxes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:paddingLeft="@dimen/horizontal_margin_half"
                            android:text="Боксы"
                            android:textColor="@color/White"
                            android:textColorHint="@color/BlueLight"
                            android:textIsSelectable="false"
                            android:textSize="@dimen/text_normal" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_arrow_right" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:visibility="gone"
                        android:background="@color/BlueTransparent"></FrameLayout>

                    <LinearLayout
                        android:id="@+id/additional"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@drawable/background_list_item_buttons"
                        android:clickable="true"
                        android:orientation="horizontal"
                        android:paddingBottom="@dimen/vertical_margin_half"
                        android:visibility="gone"
                        android:paddingTop="@dimen/vertical_margin_half">

                        <TextView
                            android:id="@+id/txtAdditional"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:paddingLeft="@dimen/horizontal_margin_half"
                            android:text="Дополнительно"
                            android:textColor="@color/White"
                            android:textColorHint="@color/BlueLight"
                            android:textIsSelectable="false"
                            android:textSize="@dimen/text_normal" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_arrow_right" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@color/BlueTransparent"></FrameLayout>

                    <LinearLayout
                        android:id="@+id/notification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@drawable/background_list_item_buttons"
                        android:orientation="horizontal"
                        android:paddingBottom="@dimen/vertical_margin_half"
                        android:paddingTop="@dimen/vertical_margin_half">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/horizontal_margin_half"
                            android:layout_weight="5"
                            android:text="Получать уведомления"
                            android:textColor="@drawable/button_state_color"
                            android:textColorHint="@color/BlueLight"
                            android:textIsSelectable="false"
                            android:textSize="@dimen/text_normal" />

                        <LinearLayout
                            android:layout_width="0dip"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|right"
                            android:layout_weight="0.4"
                            android:gravity="right">

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="2dp">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_checkmark_off" />

                                <ImageView
                                    android:id="@+id/checkbox"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:src="@drawable/background_list_item_checkmark" />
                            </FrameLayout>

                            <CheckBox
                                android:id="@+id/receive_notification"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:button="@drawable/background_checkbox"
                                android:checked="true"
                                android:gravity="right|center"
                                android:padding="0dp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@color/BlueTransparent"></FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@drawable/background_list_item_buttons"
                        android:orientation="horizontal"
                        android:paddingBottom="@dimen/vertical_margin_half"
                        android:paddingTop="@dimen/vertical_margin_half">

                        <TextView
                            android:id="@+id/washerStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:paddingLeft="@dimen/horizontal_margin_half"
                            android:text="Ваш запрос находится в обработке..."
                            android:textColor="@color/White"
                            android:textColorHint="@color/BlueLight"
                            android:textIsSelectable="false"
                            android:textSize="@dimen/text_normal" />
                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/activate_washer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@drawable/background_list_item_buttons"
                        android:orientation="horizontal"
                        android:paddingBottom="@dimen/vertical_margin_half"
                        android:paddingTop="@dimen/vertical_margin_half"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:paddingLeft="@dimen/horizontal_margin_half"
                            android:text="Мойка активна"
                            android:textColor="@color/White"
                            android:textColorHint="@color/BlueLight"
                            android:textIsSelectable="false"
                            android:textSize="@dimen/text_normal" />

                        <LinearLayout
                            android:layout_width="0dip"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:layout_weight="0.4"
                            android:gravity="center">

                            <CheckBox
                                android:id="@+id/public_washer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:button="@drawable/background_checkbox"
                                android:checked="false"
                                android:gravity="left|center"
                                android:padding="0dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@color/BlueTransparent"></FrameLayout>

                    <Button
                        android:id="@+id/btnSave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="@dimen/vertical_margin_double"
                        android:layout_marginTop="@dimen/vertical_margin_double"
                        android:background="@drawable/background_button_border"
                        android:padding="10dp"
                        android:text="Сохранить"
                        android:textColor="@drawable/button_state_color"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</LinearLayout>
