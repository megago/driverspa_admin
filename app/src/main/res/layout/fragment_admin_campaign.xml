<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:ProgressWheel="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/washCountCampaignLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|left"
                android:paddingLeft="@dimen/horizontal_margin"
                android:gravity="left"
                android:background="#50000000"
                android:paddingBottom="@dimen/vertical_margin_third"
                android:paddingTop="@dimen/vertical_margin_third"
                android:text="@string/promos_by_wash_count"
                android:textColor="@color/White"
                android:textSize="@dimen/text_normal" />

            <TextView
                android:id="@+id/noWashCountCampaign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:paddingLeft="@dimen/horizontal_margin_half"
                android:text="@string/no_wash_count_promo"
                android:textColor="@color/White"
                android:textColorHint="@color/BlueLight"
                android:textIsSelectable="false"
                android:visibility="gone"
                android:textSize="@dimen/text_normal" />

            <com.driverspa.view.ExpandableListView
                android:id="@+id/list_view"
                android:layout_width="match_parent"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:footerDividersEnabled="true"
                android:divider="@color/list_divider"
                android:dividerHeight="1dp"
                android:scrollbars="none" />

            <Button
                android:id="@+id/btnAddWashCountCampaign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/background_button_border"
                android:paddingBottom="10dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="10dp"
                android:text="@string/add"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:textColor="@drawable/button_state_color"
                android:textSize="@dimen/text_normal" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/vertical_margin_half"
            android:layout_marginLeft="@dimen/horizontal_margin"
            android:layout_marginRight="@dimen/horizontal_margin"
            android:visibility="gone"
            android:background="@color/BlueTransparent"></FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|left"
                android:paddingLeft="@dimen/horizontal_margin"
                android:gravity="left"
                android:background="#50000000"
                android:paddingBottom="@dimen/vertical_margin_third"
                android:paddingTop="@dimen/vertical_margin_third"
                android:text="@string/wash_discounts"
                android:textColor="@color/White"
                android:layout_marginTop="@dimen/vertical_margin"
                android:textSize="@dimen/text_normal" />

            <TextView
                android:id="@+id/noCampaign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:paddingLeft="@dimen/horizontal_margin_half"
                android:text="@string/no_discounts"
                android:visibility="gone"
                android:textColor="@color/White"
                android:textColorHint="@color/BlueLight"
                android:textIsSelectable="false"
                android:textSize="@dimen/text_normal" />

            <LinearLayout
                android:id="@+id/campaignLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="@dimen/vertical_margin"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:gravity="center"
                    android:text="@string/add_promo_title"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_normal"
                    android:visibility="gone" />


                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@color/BlueTransparent"
                    android:visibility="gone"></FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/horizontal_margin_double"
                    android:layout_marginRight="@dimen/horizontal_margin_double"
                    android:background="@drawable/background_list_item_buttons"
                    android:clickable="true"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/vertical_margin_half"
                    android:paddingTop="@dimen/vertical_margin_half">

                    <TextView
                        android:id="@+id/description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center|top"
                        android:paddingBottom="@dimen/vertical_margin_third"
                        android:paddingTop="@dimen/vertical_margin_third"
                        android:text=""
                        android:textColor="@color/White"
                        android:textColorHint="@color/BlueLight"
                        android:textCursorDrawable="@null"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/text_normal" />

                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:background="@color/BlueTransparent"
                    android:visibility="gone"></FrameLayout>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|left"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:gravity="center"
                    android:paddingBottom="@dimen/vertical_margin_third"
                    android:paddingTop="@dimen/vertical_margin_third"
                    android:text="@string/promo_end_date_incl"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_normal"
                    android:visibility="gone" />


                <TextView
                    android:id="@+id/endDate"
                    style="@style/EditText.Transparent"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:hint="01.01.2016"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences"
                    android:text=""
                    android:textColor="@color/White"
                    android:textColorHint="@color/BlueLight"
                    android:textCursorDrawable="@null"
                    android:textIsSelectable="false"
                    android:textSize="@dimen/text_normal"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:layout_marginRight="@dimen/horizontal_margin"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/vertical_margin_half"
                    android:paddingTop="@dimen/vertical_margin_half">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/horizontal_margin_half"
                        android:gravity="center"
                        android:text="@string/discount"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_normal" />

                    <FrameLayout
                        android:id="@+id/discountLayout"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="@dimen/horizontal_margin_third"
                        android:background="@drawable/ic_discount_bg_list">

                        <TextView
                            android:id="@+id/discount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginLeft="2dp"
                            android:text=""
                            android:textSize="@dimen/text_normal"
                            android:textStyle="bold"
                            android:textColor="@color/White" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|left"
                        android:gravity="center"
                        android:text="%"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_normal"
                        android:visibility="gone" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/auction_time"
                    android:layout_gravity="center">

                    <com.todddavies.components.progressbar.ProgressWheel
                        android:id="@+id/progress_wheel"
                        ProgressWheel:barColor="@color/Red"
                        ProgressWheel:barLength2="60dp"
                        ProgressWheel:barWidth="15dp"
                        ProgressWheel:rimColor="@color/BlueLight"
                        ProgressWheel:rimWidth="15dp"
                        ProgressWheel:spinSpeed="3dp"
                        ProgressWheel:textColor="@android:color/transparent"
                        ProgressWheel:textSize="@dimen/text_normal"
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_centerHorizontal="true"
                        android:layout_gravity="center" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/remaining_colon"
                            android:textColor="@color/White"
                            android:textSize="@dimen/text_medium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/remaining_time_unknown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/unknown"
                            android:textColor="@color/White"
                            android:textSize="@dimen/text_normal" />

                        <LinearLayout
                            android:id="@+id/mon_days_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/months"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:text="0"
                                android:textColor="@color/White"
                                android:textSize="@dimen/text_normal"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/months_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginLeft="@dimen/horizontal_margin_third"
                                android:gravity="center"
                                android:text="@string/month_short"
                                android:textColor="@color/White"
                                android:textSize="@dimen/text_normal" />

                            <TextView
                                android:id="@+id/days"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginLeft="@dimen/horizontal_margin_third"
                                android:gravity="center"
                                android:text="0"
                                android:textColor="@color/White"
                                android:textSize="@dimen/text_normal"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/days_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginLeft="@dimen/horizontal_margin_third"
                                android:gravity="center"
                                android:text="@string/days"
                                android:textColor="@color/White"
                                android:textSize="@dimen/text_normal" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/times_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="40dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/hours"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:text="05"
                                    android:textColor="@color/White"
                                    android:textSize="@dimen/text_normal"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/hours_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:text="@string/hours"
                                    android:textColor="@color/White"
                                    android:textSize="@dimen/text_normal" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:text=":"
                                    android:textColor="@color/White"
                                    android:textSize="@dimen/text_normal" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="40dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/minutes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:text="05"
                                    android:textColor="@color/White"
                                    android:textSize="@dimen/text_normal"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/minutes_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:text="@string/minutes"
                                    android:textColor="@color/White"
                                    android:textSize="@dimen/text_normal" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:text=":"
                                    android:textColor="@color/White"
                                    android:textSize="@dimen/text_normal" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="45dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/seconds"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:text="04"
                                    android:textColor="@color/White"
                                    android:textSize="@dimen/text_normal"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/seconds_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:text="@string/seconds"
                                    android:textColor="@color/White"
                                    android:textSize="@dimen/text_normal" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </FrameLayout>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|left"
                    android:layout_marginLeft="@dimen/horizontal_margin"
                    android:gravity="center"
                    android:paddingBottom="@dimen/vertical_margin_third"
                    android:paddingTop="@dimen/vertical_margin_third"
                    android:text="@string/promo_short_desc"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_normal"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/campaignTypeLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/horizontal_margin_double"
                    android:layout_marginRight="@dimen/horizontal_margin_double"
                    android:background="@drawable/background_list_item_buttons"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/vertical_margin_half"
                    android:paddingTop="@dimen/vertical_margin">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="top|center"
                        android:src="@drawable/ic_about_us"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/campaignType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center|top"
                        android:text=""
                        android:textColor="@color/White"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/text_normal"
                        android:textStyle="italic" />
                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btnAddCampaign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/background_button_border"
                android:paddingBottom="10dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="10dp"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:text="@string/add"
                android:textColor="@drawable/button_state_color"
                android:visibility="gone"
                android:textSize="@dimen/text_normal" />

            <Button
                android:id="@+id/btnDeleteCampaign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/background_button_border"
                android:paddingBottom="10dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="10dp"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:text="@string/delete"
                android:textColor="@drawable/button_state_color"
                android:visibility="gone"
                android:textSize="@dimen/text_normal" />

        </LinearLayout>
    </LinearLayout>

</ScrollView>
