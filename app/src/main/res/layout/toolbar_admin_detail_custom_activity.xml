<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar style="@style/ToolBarStyle"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_scrollFlags="scroll|enterAlways|snap"
    android:background="@android:color/transparent"
    android:minHeight="@dimen/abc_action_bar_default_height_material"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.driverspa.view.NDSpinner
        android:id="@+id/spinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|left"
        android:drawSelectorOnTop="true"
        android:popupBackground="@color/spinner_popup_background"
        android:spinnerMode="dropdown"
        android:textColor="@drawable/button_state_color"
        android:textCursorDrawable="@null"
        android:visibility="gone"
        android:textSize="@dimen/text_medium" />

    <TextView
        android:id="@+id/action_bar_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:layout_gravity="left"
        android:textSize="@dimen/text_normal"
        android:gravity="center"
        android:textStyle="bold"
        android:transitionName="title_transition"
        android:textColor="@drawable/button_state_color"/>

    <TextView
        android:id="@+id/action_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Готово"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_gravity="right"
        android:textSize="@dimen/text_normal"
        android:gravity="center"
        android:padding="@dimen/horizontal_margin"
        android:background="@android:color/transparent"
        android:transitionName="title_transition"
        android:textColor="@drawable/button_state_color"/>

    <!--android:drawablePadding="@dimen/horizontal_margin_third"-->
    <!--android:drawableRight="@drawable/ic_checkmark"-->
    </androidx.appcompat.widget.Toolbar>