<?xml version="1.0" encoding="utf-8"?>
<!-- Отчёт (ShopReportFragment): a period, the totals, sales per item and the low stock. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="@dimen/vertical_margin">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vertical_margin_half"
            android:fadingEdge="none"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/periodToday"
                    style="@style/PaymentTab"
                    android:text="@string/today" />

                <TextView
                    android:id="@+id/periodWeek"
                    style="@style/PaymentTab"
                    android:text="@string/shop_period_week" />

                <TextView
                    android:id="@+id/periodMonth"
                    style="@style/PaymentTab"
                    android:text="@string/shop_period_month" />

                <TextView
                    android:id="@+id/periodCustom"
                    style="@style/PaymentTab"
                    android:text="@string/shop_period_custom" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/from_word"
                android:textColor="@color/AntiqueWhite"
                android:textSize="@dimen/text_small" />

            <TextView
                android:id="@+id/fromDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:padding="4dp"
                android:textColor="@drawable/button_state_color"
                android:textSize="@dimen/text_small"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:text="@string/to_word"
                android:textColor="@color/AntiqueWhite"
                android:textSize="@dimen/text_small" />

            <TextView
                android:id="@+id/toDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:padding="4dp"
                android:textColor="@drawable/button_state_color"
                android:textSize="@dimen/text_small"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/revenueCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_v2_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shop_revenue"
                    android:textColor="@color/BlueLight"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/revenue"
                    style="@style/ShopCardValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/costCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_v2_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shop_cost"
                    android:textColor="@color/BlueLight"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/cost"
                    style="@style/ShopCardValue" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/profitCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_v2_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shop_profit"
                    android:textColor="@color/BlueLight"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/profit"
                    style="@style/ShopCardValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/salesCountCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_v2_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shop_sales_count"
                    android:textColor="@color/BlueLight"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/salesCount"
                    style="@style/ShopCardValue" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/averageCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_v2_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shop_average"
                    android:textColor="@color/BlueLight"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/average"
                    style="@style/ShopCardValue" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/reportEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="@string/shop_report_empty"
            android:textColor="@color/BlueLight"
            android:textSize="@dimen/text_normal"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/itemsTable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/BlueTransparent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/colName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:gravity="start"
                    android:padding="4dp"
                    android:text="@string/shop_col_item"
                    android:textColor="@color/BlueLight2"
                    android:textSize="@dimen/text_smaller"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/colQty"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:gravity="end"
                    android:padding="4dp"
                    android:text="@string/shop_col_qty"
                    android:textColor="@color/BlueLight2"
                    android:textSize="@dimen/text_smaller"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/colRevenue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:gravity="end"
                    android:padding="4dp"
                    android:text="@string/shop_revenue"
                    android:textColor="@color/BlueLight2"
                    android:textSize="@dimen/text_smaller"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/colCost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:gravity="end"
                    android:padding="4dp"
                    android:text="@string/shop_cost"
                    android:textColor="@color/BlueLight2"
                    android:textSize="@dimen/text_smaller"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/colProfit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:gravity="end"
                    android:padding="4dp"
                    android:text="@string/shop_profit"
                    android:textColor="@color/BlueLight2"
                    android:textSize="@dimen/text_smaller"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/itemsRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingLeft="4dp"
            android:text="@string/shop_low_stock_title"
            android:textColor="@color/White"
            android:textSize="@dimen/text_normal"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/lowRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="4dp" />
    </LinearLayout>
</ScrollView>
