<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomLayout"
        android:orientation="vertical">

        <TextView
            android:id="@+id/washCountCampaignDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/Red"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:text=""
            android:textColor="@color/White"
            android:textSize="@dimen/text_smaller"
            android:visibility="gone" />

        <include
            android:id="@+id/toolbar_actionbar"
            layout="@layout/toolbar_admin_detail_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Step indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/stepHeader1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">
                <View
                    android:id="@+id/stepDot1"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_v2_step_dot" />
                <TextView
                    android:id="@+id/stepLabel1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Авто"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_small"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:id="@+id/stepConnector12"
                android:layout_width="20dp"
                android:layout_height="1dp"
                android:layout_gravity="center_vertical"
                android:background="@color/BlueLight" />

            <LinearLayout
                android:id="@+id/stepHeader2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">
                <View
                    android:id="@+id/stepDot2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_v2_step_dot" />
                <TextView
                    android:id="@+id/stepLabel2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Услуги"
                    android:textColor="@color/BlueLight"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>

            <View
                android:id="@+id/stepConnector23"
                android:layout_width="20dp"
                android:layout_height="1dp"
                android:layout_gravity="center_vertical"
                android:background="@color/BlueLight" />

            <LinearLayout
                android:id="@+id/stepHeader3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">
                <View
                    android:id="@+id/stepDot3"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_v2_step_dot" />
                <TextView
                    android:id="@+id/stepLabel3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Оплата"
                    android:textColor="@color/BlueLight"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/BlueTransparent" />

        <!-- Step host (only one visible at a time) -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/stepCarHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <include layout="@layout/view_add_queue_v2_step_car" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/stepServicesHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <include layout="@layout/view_add_book_step_services" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/stepPaymentHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <include layout="@layout/view_add_queue_v2_step_payment" />
                </LinearLayout>
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Sticky footer: live summary + nav buttons -->
    <LinearLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#101724"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/BlueTransparent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/priceLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Стоимость"
                        android:textColor="@color/BlueLight"
                        android:textSize="@dimen/text_smaller" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="6dp"
                        android:text="·"
                        android:textColor="@color/BlueLight"
                        android:textSize="@dimen/text_smaller" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="6dp"
                        android:text="Время"
                        android:textColor="@color/BlueLight"
                        android:textSize="@dimen/text_smaller" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/txtPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 ₸"
                        android:textColor="@color/White"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="·"
                        android:textColor="@color/BlueLight"
                        android:textSize="@dimen/text_medium" />
                    <TextView
                        android:id="@+id/txtTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="0 мин"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_small" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtPriceDifference"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Остаток 0 ₸"
                    android:textColor="@color/BlueLight2"
                    android:textSize="@dimen/text_smaller" />
            </LinearLayout>

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_v2_btn_ghost"
                android:minHeight="44dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="Назад"
                android:textAllCaps="false"
                android:textColor="@color/White"
                android:textSize="@dimen/text_small" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_v2_btn_primary"
                android:minHeight="44dp"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="Далее"
                android:textAllCaps="false"
                android:textColor="@color/White"
                android:textSize="@dimen/text_small"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBook"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_v2_btn_primary"
                android:minHeight="44dp"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="Бронировать"
                android:textAllCaps="false"
                android:textColor="@color/White"
                android:textSize="@dimen/text_small"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
