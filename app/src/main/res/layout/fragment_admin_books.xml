<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/filterLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnPending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:background="@null"
            android:clickable="true"
            android:gravity="center"
            android:text="В ОБРАБОТКЕ"
            android:textColor="@drawable/button_bar_state_color"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnToday"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight=".8"
            android:background="@null"
            android:clickable="true"
            android:gravity="center"
            android:text="СЕГОДНЯ"
            android:textColor="@drawable/button_bar_state_color"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTomorrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight=".6"
            android:background="@null"
            android:clickable="true"
            android:gravity="center"
            android:text="ВСЕ"
            android:textColor="@drawable/button_bar_state_color"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/queueLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/filterLayout"
        android:visibility="gone"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:background="@null"
            android:clickable="true"
            android:layout_marginLeft="@dimen/horizontal_margin"
            android:gravity="left"
            android:textStyle="bold"
            android:textSize="@dimen/text_normal"
            android:text="Живая очередь"
            android:textColor="@color/White"
            />
        <FrameLayout
            android:id="@+id/line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/vertical_margin_third"
            android:background="@color/BlueTransparent" />

        <!--android:background="@drawable/gradient_bg"-->
        <com.driverspa.view.TwoWayView
            android:id="@+id/queue_horizontal_list"
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_queue_height"
            android:layout_below="@+id/line"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="1dp"
            android:paddingTop="@dimen/vertical_margin_third"
            android:paddingBottom="@dimen/vertical_margin_third"
            android:drawSelectorOnTop="false"
            android:listSelector="@android:color/transparent"
            android:orientation="horizontal"
            android:scrollbars="none" />

        <FrameLayout
            android:id="@+id/line2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/queue_horizontal_list"
            android:background="@color/BlueTransparent" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/queueLayout"
        android:layout_marginLeft="@dimen/horizontal_margin"
        android:layout_marginRight="@dimen/horizontal_margin">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_linear"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
        />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/noInternetLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/noInternetMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connection_error"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/White"
            android:textSize="@dimen/text_normal" />

        <Button
            android:id="@+id/repeatConnect"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="@string/retry"
            android:textColor="#fff" />
    </LinearLayout>

    <TextView
        android:id="@+id/noRecords"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:layout_marginLeft="@dimen/horizontal_margin_double"
        android:layout_marginRight="@dimen/horizontal_margin_double"
        android:text="Нет заказов"
        android:gravity="center"
        android:textColor="@color/White"
        android:textSize="@dimen/text_normal"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="false"
        android:layout_marginTop="120dp"
        android:visibility="visible" />

    <FrameLayout
        android:id="@+id/bookBtn"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="@dimen/vertical_margin"
        android:layout_marginRight="@dimen/horizontal_margin"
        android:background="@drawable/background_red_button_oval"
        android:visibility="gone">

        <ImageView
            android:id="@+id/buttonBook"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_timer_white_24dp" />
    </FrameLayout>

</RelativeLayout>