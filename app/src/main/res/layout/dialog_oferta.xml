<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/myPrimaryColor"
    android:orientation="vertical">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/myPrimaryDarkColor"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Публичная оферта"
            android:textColor="@color/White"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/ofertaClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:text="✕"
            android:textColor="@color/White"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Progress shown while the page loads -->
    <ProgressBar
        android:id="@+id/ofertaProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="40dp" />

    <!-- WebView fills remaining space -->
    <WebView
        android:id="@+id/ofertaWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Agree button at bottom -->
    <Button
        android:id="@+id/ofertaAgree"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/background_button_borderless"
        android:paddingBottom="14dp"
        android:paddingTop="14dp"
        android:text="Согласен с офертой"
        android:textColor="@color/White"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
