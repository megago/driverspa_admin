<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/custom_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_bg" />

    <RelativeLayout
        android:id="@+id/navigationHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/navigation_top_header">

        <ImageView
            android:id="@+id/profile_avatar_invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignTop="@+id/headerContent"
            android:layout_alignBottom="@+id/headerContent"
            android:scaleType="centerCrop"/>

        <FrameLayout
            android:id="@+id/fade_for_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignTop="@+id/headerContent"
            android:layout_alignBottom="@+id/headerContent"
            android:background="@drawable/gradient_bg"
            android:visibility="gone" />

        <RelativeLayout
            android:id="@+id/headerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/vertical_margin_half">

        <ImageView
            android:id="@+id/profile_avatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginBottom="8dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:src="@drawable/ic_image_place_holder" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/profile_avatar"
            android:layout_marginTop="@dimen/vertical_margin"
            android:layout_marginBottom="8dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/washer_name_lc"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_normal"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/user_role"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/washer_name_lc"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_smaller" />

            <LinearLayout
                android:id="@+id/spinnerLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|left"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:orientation="horizontal">
                <com.driverspa.view.NDSpinner
                    android:theme="@style/SpinnerThemeOverlay"
                    android:id="@+id/washer_spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@null"
                    android:drawSelectorOnTop="true"
                    android:popupBackground="@color/spinner_popup_background"
                    android:spinnerMode="dropdown"
                    android:textColor="@drawable/button_state_color"
                    android:textCursorDrawable="@null"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>

            <TextView
                android:id="@+id/profile_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+7 777 708 2344"
                android:textColor="@android:color/white" />
        </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/drawerList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/navigationHeader"
        android:layout_above="@id/line"
        android:clickable="true"
        android:fitsSystemWindows="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollbars="vertical" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/line"
        android:layout_marginLeft="@dimen/horizontal_margin_third"
        android:visibility="gone"
        android:layout_below="@+id/drawerList">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="8dp"
            android:layout_marginLeft="@dimen/horizontal_margin"
            android:layout_marginRight="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/support_colon"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_small" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/ic_phone"
                android:drawablePadding="@dimen/horizontal_margin_third"
                android:text="+7 778 373 6069"
                android:autoLink="phone"
                android:textSize="@dimen/text_small"
                android:textColorLink="@color/GreenYellow"
                android:textColor="@android:color/white" />
        </LinearLayout>

    </FrameLayout>

    <View
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_above="@id/logout"
        android:layout_marginBottom="@dimen/vertical_margin"
        android:background="@drawable/divider" />

    <TextView
        android:id="@+id/logout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="@dimen/horizontal_margin"
        android:clickable="true"
        android:drawableLeft="@drawable/ic_logout"
        android:drawablePadding="@dimen/horizontal_margin"
        android:paddingBottom="@dimen/vertical_margin"
        android:text="@string/logout"
        android:textColor="@drawable/button_state_color"
        android:textSize="@dimen/text_normal" />

    <TextView
        android:id="@+id/version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginRight="@dimen/horizontal_margin"
        android:layout_marginBottom="@dimen/vertical_margin_half"
        android:clickable="true"
        android:text=""
        android:textColor="@drawable/button_state_color"
        android:textSize="@dimen/text_smaller" />

</RelativeLayout>