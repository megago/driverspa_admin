<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar_actionbar"
        layout="@layout/toolbar_admin_detail_custom_activity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/vertical_margin"
        android:layout_marginLeft="@dimen/horizontal_margin"
        android:layout_marginRight="@dimen/horizontal_margin"
        android:layout_marginTop="@dimen/vertical_margin_half"
        android:gravity="center"
        android:text="Адрес"
        android:textColor="@color/White"
        android:textSize="@dimen/text_normal"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:orientation="vertical"
                android:paddingBottom="@dimen/vertical_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
            app:defaultHintTextColor="@color/actionbar_color"
            app:hintTextColor="@color/actionbar_color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin">

                        <EditText
                            android:id="@+id/streetName"
                            style="@style/EditText.Transparent"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:hint="Улица, Дом"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:textColor="@color/White"
                            android:textColorHint="@color/actionbar_color"
                            android:textCursorDrawable="@null"
                            android:textIsSelectable="false"
                            android:textSize="@dimen/text_normal" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:layout_marginTop="@dimen/vertical_margin_half"
                        android:background="@color/BlueTransparent"></FrameLayout>

                    <EditText
                        android:id="@+id/homeNumber"
                        style="@style/EditText.Transparent"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:layout_marginTop="@dimen/vertical_margin"
                        android:hint="Дом"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:textColor="@color/AntiqueWhite"
                        android:textColorHint="@color/actionbar_color"
                        android:textCursorDrawable="@null"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/text_normal"
                        android:visibility="gone" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:layout_marginTop="@dimen/vertical_margin_half"
                        android:background="@color/BlueTransparent"
                        android:visibility="gone"></FrameLayout>

                    <LinearLayout
                        android:id="@+id/map"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@drawable/background_list_item_buttons"
                        android:clickable="true"
                        android:orientation="horizontal"
                        android:paddingBottom="@dimen/vertical_margin_half"
                        android:paddingTop="@dimen/vertical_margin_half">

                        <ImageView
                            android:id="@+id/icon_pin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_pin"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/txtMap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:paddingLeft="@dimen/horizontal_margin_half"
                            android:text="Отметить на карте"
                            android:textColor="@color/White"
                            android:textColorHint="@color/actionbar_color"
                            android:textIsSelectable="false"
                            android:textSize="@dimen/text_normal" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_arrow_right" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="@dimen/horizontal_margin"
                        android:layout_marginRight="@dimen/horizontal_margin"
                        android:background="@color/BlueTransparent"></FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>


</LinearLayout>