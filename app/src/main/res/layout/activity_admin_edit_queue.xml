<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomLayout"
        android:orientation="vertical">

        <TextView
            android:id="@+id/washCountCampaignDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/Red"
            android:gravity="center"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text=""
            android:textColor="@color/White"
            android:textIsSelectable="false"
            android:textSize="@dimen/text_smaller"
            android:visibility="gone" />

        <include
            android:id="@+id/toolbar_actionbar"
            layout="@layout/toolbar_admin_detail_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/txtBookTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_v2_card_accent"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/booking_at_0800"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_normal"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Car & client card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_v2_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/car_plate"
                        android:textColor="@color/BlueLight"
                        android:textSize="@dimen/text_smaller" />

                    <TextView
                        android:id="@+id/carNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_v2_plate"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:text=""
                        android:textColor="#0A1428"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <!-- Car brand -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/car_brand"
                        android:textColor="@color/BlueLight"
                        android:textSize="@dimen/text_smaller" />

                    <EditText
                        android:id="@+id/carMark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_v2_field"
                        android:hint="@string/example_toyota"
                        android:imeOptions="actionNext"
                        android:inputType="textCapSentences"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:textColor="@color/White"
                        android:textColorHint="@color/BlueLight"
                        android:textCursorDrawable="@null"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/text_small" />

                    <!-- Client section header -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/client"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_normal"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/client_name"
                        android:textColor="@color/BlueLight"
                        android:textSize="@dimen/text_smaller" />

                    <EditText
                        android:id="@+id/clientName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_v2_field"
                        android:hint="@string/client_name"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:textColor="@color/White"
                        android:textColorHint="@color/BlueLight"
                        android:textCursorDrawable="@null"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/text_small" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/phone"
                        android:textColor="@color/BlueLight"
                        android:textSize="@dimen/text_smaller" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_v2_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingRight="4dp"
                            android:text="+7"
                            android:textColor="@color/White"
                            android:textSize="@dimen/text_normal"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/phone"
                            style="@style/EditText.Transparent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:hint="(___) ___ __-__"
                            android:imeOptions="actionNext"
                            android:inputType="phone"
                            android:paddingLeft="4dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:textColor="@color/White"
                            android:textColorHint="@color/BlueLight"
                            android:textCursorDrawable="@null"
                            android:textIsSelectable="false"
                            android:textSize="@dimen/text_small" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Car type card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_v2_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/car_type"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_normal"
                        android:textStyle="bold" />

                    <!-- Auto-wrapping flow; items per row adapt to the available width. -->
                    <com.driverspa.view.FlowLayout
                        android:id="@+id/carTypesGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <LinearLayout
                            android:id="@+id/btnMini"
                            android:layout_width="84dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_v2_car_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minHeight="92dp"
                            android:orientation="vertical"
                            android:padding="6dp">
                            <ImageView
                                android:id="@+id/imageView112"
                                android:layout_width="48dp"
                                android:layout_height="36dp"
                                android:src="@drawable/background_button_crossover" />
                            <TextView
                                android:id="@+id/textView111"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:text="@string/mini"
                                android:textColor="@color/White"
                                android:textSize="@dimen/text_smaller" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnSedan"
                            android:layout_width="84dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_v2_car_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minHeight="92dp"
                            android:orientation="vertical"
                            android:padding="6dp">
                            <ImageView
                                android:id="@+id/imageView1"
                                android:layout_width="52dp"
                                android:layout_height="36dp"
                                android:src="@drawable/background_button_sedan" />
                            <TextView
                                android:id="@+id/textView1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:text="@string/sedan"
                                android:textColor="@color/White"
                                android:textSize="@dimen/text_smaller" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnUniversal"
                            android:layout_width="84dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_v2_car_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minHeight="92dp"
                            android:orientation="vertical"
                            android:padding="6dp">
                            <ImageView
                                android:id="@+id/imageView114"
                                android:layout_width="56dp"
                                android:layout_height="36dp"
                                android:src="@drawable/background_button_crossover" />
                            <TextView
                                android:id="@+id/textView115"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:text="@string/wagon"
                                android:textColor="@color/White"
                                android:textSize="@dimen/text_smaller" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnCrossover"
                            android:layout_width="84dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_v2_car_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minHeight="92dp"
                            android:orientation="vertical"
                            android:padding="6dp">
                            <ImageView
                                android:id="@+id/imageView2"
                                android:layout_width="56dp"
                                android:layout_height="36dp"
                                android:src="@drawable/background_button_crossover" />
                            <TextView
                                android:id="@+id/textView2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:text="@string/crossover"
                                android:textColor="@color/White"
                                android:textSize="@dimen/text_smaller" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnMiniJeep"
                            android:layout_width="84dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_v2_car_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minHeight="92dp"
                            android:orientation="vertical"
                            android:padding="6dp">
                            <ImageView
                                android:id="@+id/imageView44"
                                android:layout_width="54dp"
                                android:layout_height="36dp"
                                android:src="@drawable/background_button_jeep" />
                            <TextView
                                android:id="@+id/textView33"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:text="@string/mini_jeep"
                                android:textColor="@color/White"
                                android:textSize="@dimen/text_smaller" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnBigJeep"
                            android:layout_width="84dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_v2_car_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minHeight="92dp"
                            android:orientation="vertical"
                            android:padding="6dp">
                            <ImageView
                                android:id="@+id/imageView4"
                                android:layout_width="56dp"
                                android:layout_height="36dp"
                                android:src="@drawable/background_button_jeep" />
                            <TextView
                                android:id="@+id/textView3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:text="@string/jeep"
                                android:textColor="@color/White"
                                android:textSize="@dimen/text_smaller" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnMoto"
                            android:layout_width="84dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_v2_car_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minHeight="92dp"
                            android:orientation="vertical"
                            android:padding="6dp">
                            <ImageView
                                android:id="@+id/imageView33"
                                android:layout_width="50dp"
                                android:layout_height="36dp"
                                android:src="@drawable/background_button_moto" />
                            <TextView
                                android:id="@+id/textView99"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:text="@string/motorcycle"
                                android:textColor="@color/White"
                                android:textSize="@dimen/text_smaller" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnMinivan"
                            android:layout_width="84dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_v2_car_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minHeight="92dp"
                            android:orientation="vertical"
                            android:padding="6dp">
                            <ImageView
                                android:id="@+id/imageView36"
                                android:layout_width="54dp"
                                android:layout_height="36dp"
                                android:src="@drawable/background_button_minbus" />
                            <TextView
                                android:id="@+id/textView999"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:text="@string/minivan"
                                android:textColor="@color/White"
                                android:textSize="@dimen/text_smaller" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnMinbus"
                            android:layout_width="84dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_v2_car_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minHeight="92dp"
                            android:orientation="vertical"
                            android:padding="6dp">
                            <ImageView
                                android:id="@+id/imageView3"
                                android:layout_width="56dp"
                                android:layout_height="36dp"
                                android:src="@drawable/background_button_minbus" />
                            <TextView
                                android:id="@+id/textView9"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:text="@string/minibus"
                                android:textColor="@color/White"
                                android:textSize="@dimen/text_smaller" />
                        </LinearLayout>
                    </com.driverspa.view.FlowLayout>
                </LinearLayout>

                <!-- Services card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_v2_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/services"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_normal"
                        android:textStyle="bold" />

                    <com.driverspa.view.ExpandableGridView
                        android:id="@+id/grid_group_services"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:adjustViewBounds="true"
                        android:horizontalSpacing="6dp"
                        android:isScrollContainer="false"
                        android:listSelector="@android:color/transparent"
                        android:numColumns="auto_fit"
                        android:padding="1dp"
                        android:stretchMode="none"
                        android:verticalSpacing="6dp"
                        android:visibility="gone" />

                    <com.driverspa.view.ExpandableGridView
                        android:id="@+id/grid_services"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:adjustViewBounds="true"
                        android:horizontalSpacing="6dp"
                        android:isScrollContainer="false"
                        android:listSelector="@android:color/transparent"
                        android:numColumns="auto_fit"
                        android:padding="1dp"
                        android:stretchMode="none"
                        android:verticalSpacing="6dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/no_service"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:text="@string/no_available_services"
                        android:textColor="@color/BlueLight"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/text_small" />
                </LinearLayout>

                <!-- Boxes card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_v2_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/box"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_normal"
                        android:textStyle="bold" />

                    <com.driverspa.view.ExpandableGridView
                        android:id="@+id/grid_boxes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:adjustViewBounds="true"
                        android:horizontalSpacing="6dp"
                        android:isScrollContainer="false"
                        android:listSelector="@android:color/transparent"
                        android:numColumns="auto_fit"
                        android:padding="1dp"
                        android:stretchMode="none"
                        android:verticalSpacing="6dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/no_offline_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:text="@string/no_boxes_for_queue"
                        android:textColor="@color/BlueLight"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/text_small" />
                </LinearLayout>

                <!-- Payment card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_v2_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_normal"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/paid_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="@string/client_paid_for_wash"
                            android:textColor="@color/White"
                            android:textIsSelectable="false"
                            android:textSize="@dimen/text_normal" />

                        <CheckBox
                            android:id="@+id/paid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:button="@drawable/background_checkbox"
                            android:checked="false"
                            android:padding="0dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nocashLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#15FFFFFF" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/nocashText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:text="@string/card_payment"
                                android:textColor="@color/White"
                                android:textIsSelectable="false"
                                android:textSize="@dimen/text_normal" />

                            <CheckBox
                                android:id="@+id/nocash"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:button="@drawable/background_checkbox"
                                android:checked="false"
                                android:padding="0dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Extra (discounts, comment) toggle -->
                <TextView
                    android:id="@+id/extra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_v2_card"
                    android:drawableRight="@drawable/ic_arrow_drop_down_white_24dp"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:text="@string/discounts_and_other"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_normal"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/extraLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_v2_card"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/discount"
                            android:textColor="@color/White"
                            android:textSize="@dimen/text_normal" />

                        <EditText
                            android:id="@+id/discount"
                            style="@style/EditText.Transparent.WhiteBorder"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:hint=""
                            android:inputType="number"
                            android:maxLength="3"
                            android:maxLines="1"
                            android:paddingTop="@dimen/vertical_margin_third"
                            android:paddingBottom="@dimen/vertical_margin_third"
                            android:singleLine="true"
                            android:text="0"
                            android:textColor="@color/White"
                            android:textColorHint="@color/BlueLight"
                            android:textCursorDrawable="@null"
                            android:textSize="@dimen/text_small" />

                        <EditText
                            android:id="@+id/discountAmount"
                            style="@style/EditText.Transparent.WhiteBorder"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginLeft="@dimen/horizontal_margin_third"
                            android:gravity="center"
                            android:hint=""
                            android:inputType="number"
                            android:maxLength="5"
                            android:maxLines="1"
                            android:paddingTop="@dimen/vertical_margin_third"
                            android:paddingBottom="@dimen/vertical_margin_third"
                            android:singleLine="true"
                            android:text="0"
                            android:textColor="@color/White"
                            android:textColorHint="@color/BlueLight"
                            android:textCursorDrawable="@null"
                            android:textSize="@dimen/text_small"
                            android:visibility="gone" />

                        <com.driverspa.view.NDSpinner
                            android:id="@+id/discountSpinner"
                            android:theme="@style/SpinnerThemeOverlay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginLeft="@dimen/horizontal_margin_third"
                            android:clickable="true"
                            android:drawSelectorOnTop="true"
                            android:entries="@array/newsTarget"
                            android:gravity="center"
                            android:popupBackground="@color/spinner_popup_background"
                            android:spinnerMode="dropdown"
                            android:textColor="@drawable/button_state_color"
                            android:textCursorDrawable="@null"
                            android:textSize="@dimen/text_normal" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="#15FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/comment"
                        android:textColor="@color/BlueLight"
                        android:textSize="@dimen/text_smaller" />

                    <EditText
                        android:id="@+id/comment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_v2_field"
                        android:hint="@string/comment"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:textColor="@color/White"
                        android:textColorHint="@color/BlueLight"
                        android:textCursorDrawable="@null"
                        android:textIsSelectable="false"
                        android:textSize="@dimen/text_small" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Sticky footer: live summary + actions -->
    <LinearLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#101724"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/BlueTransparent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/priceLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 ₸"
                        android:textColor="@color/White"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="·"
                        android:textColor="@color/BlueLight"
                        android:textSize="@dimen/text_medium" />

                    <TextView
                        android:id="@+id/txtTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/zero_min"
                        android:textColor="@color/White"
                        android:textSize="@dimen/text_small" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnRejectQueue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_v2_btn_ghost"
                android:minHeight="44dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="@string/delete"
                android:textAllCaps="false"
                android:textColor="@color/Red"
                android:textSize="@dimen/text_small" />

            <Button
                android:id="@+id/btnBook"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_v2_btn_primary"
                android:minHeight="44dp"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="@string/send"
                android:textAllCaps="false"
                android:textColor="@color/White"
                android:textSize="@dimen/text_small"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
