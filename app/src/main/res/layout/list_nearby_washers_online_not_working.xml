<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_list_item"
    android:focusable="false"
    android:paddingBottom="@dimen/vertical_margin"
    android:paddingTop="@dimen/vertical_margin">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="@dimen/horizontal_margin"
        android:paddingRight="@dimen/horizontal_margin">

        <LinearLayout
            android:id="@+id/reviewLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:orientation="horizontal">

            <RatingBar
                android:id="@+id/review"
                android:layout_width="wrap_content"
                android:layout_height="15dp"
                android:layout_gravity="center_horizontal"
                android:clickable="false"
                android:focusable="false"
                android:isIndicator="true"
                android:numStars="5"
                android:progressDrawable="@drawable/custom_ratingbar_disabled_selector"
                android:rating="3.0"
                android:stepSize="0.2" />

            <TextView
                android:id="@+id/txtRevCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="@dimen/horizontal_margin_third"
                android:text="12"
                android:textColor="@color/White"
                android:textSize="@dimen/text_small"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/imgSmallStar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:paddingLeft="2dp"
                android:paddingRight="@dimen/horizontal_margin_third"
                android:src="@drawable/ic_star_small_rated"
                android:textSize="@dimen/text_small"
                android:visibility="gone" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/txtLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/reviewLayout"
            android:layout_marginRight="@dimen/horizontal_margin_four"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtWasherName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Автомойка Тап Таза fgsdgf sdfgsdf gsd fgsdfg sdfg df gdf gsdf g fdgsdf gsdf gsdf gsd gfs dg sdfg sdfg sdfg sdfg sdf s"
                android:textColor="@color/BlueLight"
                android:textSize="@dimen/text_medium" />

            <ImageView
                android:id="@+id/imgAvailability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginLeft="@dimen/horizontal_margin_third"
                android:layout_weight="0"
                android:src="@drawable/ic_flag_online_list_disabled" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtWasherAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txtLayout"
            android:text="Address"
            android:textColor="@color/BlueLight"
            android:textSize="@dimen/text_normal" />

        <LinearLayout
            android:id="@+id/priceLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignLeft="@+id/txtLayout"
            android:layout_below="@+id/txtWasherAddress"
            android:layout_marginRight="@dimen/horizontal_margin_double"
            android:layout_marginTop="@dimen/vertical_margin_half">

            <TextView
                android:id="@+id/txtPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="кузов + салон от 1500"
                android:textColor="@color/BlueLight"
                android:textSize="@dimen/text_normal" />

            <ImageView
                android:layout_width="10dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:layout_marginLeft="4dp"
                android:src="@drawable/ic_tenge_disabled" />


            <TextView
                android:id="@+id/txtDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="right|center"
                android:text=""
                android:textColor="@color/White"
                android:textSize="@dimen/text_normal" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imageView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/horizontal_margin_third"
            android:src="@drawable/ic_arrow_right" />

    </RelativeLayout>
</RelativeLayout>