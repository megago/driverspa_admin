<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar_actionbar"
        layout="@layout/toolbar_admin_detail_custom_activity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/vertical_margin"
        android:layout_marginLeft="@dimen/horizontal_margin"
        android:layout_marginRight="@dimen/horizontal_margin"
        android:layout_marginTop="@dimen/vertical_margin_half"
        android:gravity="center"
        android:text="@string/additional"
        android:textColor="@color/White"
        android:textSize="@dimen/text_normal"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginLeft="@dimen/horizontal_margin_half"
            android:layout_marginRight="@dimen/horizontal_margin_half"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_third"
                android:layout_weight="5"
                android:background="#50000000"
                android:paddingLeft="@dimen/horizontal_margin_half"
                android:text="@string/name_colon"
                android:textColor="@color/White"
                android:textColorHint="@color/BlueLight"
                android:textIsSelectable="false"
                android:textSize="@dimen/text_normal" />


            <EditText
                android:id="@+id/name"
                style="@style/EditText.Transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/horizontal_margin_half"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:hint="@string/example_body_wash"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:lines="1"
                android:maxLength="30"
                android:maxLines="1"
                android:paddingLeft="0dp"
                android:text=""
                android:textColor="@color/White"
                android:textColorHint="@color/BlueLight"
                android:textCursorDrawable="@null"
                android:textIsSelectable="false"
                android:textSize="@dimen/text_normal" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:background="@color/BlueTransparent"></FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_third"
                android:layout_weight="5"
                android:background="#50000000"
                android:paddingLeft="@dimen/horizontal_margin_half"
                android:text="@string/price_and_time"
                android:textColor="@color/White"
                android:textColorHint="@color/BlueLight"
                android:textIsSelectable="false"
                android:textSize="@dimen/text_normal" />


            <LinearLayout
                android:id="@+id/priceLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"></LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/horizontal_margin_half"
        android:layout_marginTop="@dimen/vertical_margin_half"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/vertical_margin_third"
        android:paddingRight="@dimen/horizontal_margin"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|left"
            android:layout_marginRight="@dimen/horizontal_margin_third"
            android:text="@string/price"
            android:textSize="@dimen/text_normal"
            android:textColor="@color/White" />

        <EditText
            android:id="@+id/priceItem"
            style="@style/EditText.Transparent.WhiteBorder"
            android:layout_width="60dp"
            android:layout_height="25dp"
            android:layout_marginTop="@dimen/vertical_margin_third"
            android:gravity="bottom|left"
            android:inputType="number"
            android:singleLine="true"
            android:textColor="@color/White"
            android:textColorHint="@color/BlueLight"
            android:textCursorDrawable="@null"
            android:textSize="@dimen/text_normal"></EditText>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|left"
            android:layout_marginLeft="@dimen/horizontal_margin_third"
            android:text="₸"
            android:textSize="@dimen/text_normal"
            android:textColor="@color/White" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|left"
            android:layout_marginLeft="@dimen/horizontal_margin"
            android:layout_marginRight="@dimen/horizontal_margin_third"
            android:text="@string/time_word"
            android:textSize="@dimen/text_normal"
            android:textColor="@color/White" />


        <EditText
            android:id="@+id/timeItem"
            style="@style/EditText.Transparent.WhiteBorder"
            android:layout_width="50dp"
            android:layout_height="25dp"
            android:layout_marginTop="@dimen/vertical_margin_third"
            android:gravity="bottom|left"
            android:inputType="number"
            android:singleLine="true"
            android:textColor="@color/White"
            android:textColorHint="@color/BlueLight"
            android:textCursorDrawable="@null"
            android:textSize="@dimen/text_normal"></EditText>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|left"
            android:layout_marginLeft="@dimen/horizontal_margin_third"
            android:text="@string/min_dot"
            android:textSize="@dimen/text_normal"
            android:textColor="@color/White" />
    </LinearLayout>

</LinearLayout>
