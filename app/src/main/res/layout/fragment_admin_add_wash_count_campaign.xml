<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@drawable/background"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/vertical_margin"
        android:layout_marginLeft="@dimen/horizontal_margin"
        android:layout_marginRight="@dimen/horizontal_margin"
        android:gravity="center"
        android:text="Добавление акции"
        android:textColor="@color/White"
        android:textSize="@dimen/text_normal"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingBottom="@dimen/vertical_margin">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|left"
                android:paddingLeft="@dimen/horizontal_margin"
                android:gravity="left"
                android:background="#50000000"
                android:paddingBottom="@dimen/vertical_margin_third"
                android:paddingTop="@dimen/vertical_margin_third"
                android:text="Краткое описание акции (100 символов)"
                android:textColor="@color/White"
                android:textSize="@dimen/text_normal" />

            <EditText
                android:id="@+id/description"
                style="@style/EditText.Transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:maxLength="100"
                android:imeOptions="actionNext"
                android:inputType="text|textMultiLine|textCapSentences"
                android:gravity="top|left"
                android:text=""
                android:hint="Перечислите услуги или опишите акцию"
                android:textColor="@color/White"
                android:textColorHint="@color/BlueLight"
                android:textCursorDrawable="@null"
                android:textIsSelectable="false"
                android:textSize="@dimen/text_normal" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:visibility="gone"
                android:background="@color/BlueTransparent"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:paddingLeft="@dimen/horizontal_margin"
                android:gravity="left"
                android:layout_marginTop="@dimen/vertical_margin_half"
                android:paddingBottom="@dimen/vertical_margin_third"
                android:paddingTop="@dimen/vertical_margin_third"
                android:background="#50000000"
                android:text="Количество мойки для акции:"
                android:textColor="@color/White"
                android:textSize="@dimen/text_normal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|left"
                    android:layout_marginLeft="@dimen/horizontal_margin_half"
                    android:gravity="center"
                    android:paddingBottom="@dimen/vertical_margin_third"
                    android:paddingTop="@dimen/vertical_margin_third"
                    android:text="Количество мойки для акции:"
                    android:visibility="gone"
                    android:textColor="@color/White"
                    android:textSize="@dimen/text_normal" />


                <EditText
                    android:id="@+id/washCount"
                    style="@style/EditText.Transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/horizontal_margin_half"
                    android:padding="@dimen/vertical_margin_half"
                    android:gravity="left"
                    android:hint=""
                    android:inputType="number"
                    android:maxLength="2"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="0"
                    android:textColor="@color/White"
                    android:textColorHint="@color/BlueLight"
                    android:textCursorDrawable="@null"
                    android:textSize="@dimen/text_normal"></EditText>

            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:visibility="gone"
                android:background="@color/BlueTransparent"></FrameLayout>


            <Button
                android:id="@+id/btnAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/vertical_margin"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginRight="@dimen/horizontal_margin"
                android:layout_marginTop="@dimen/vertical_margin_double"
                android:background="@drawable/background_button_border"
                android:paddingBottom="5dp"
                android:visibility="gone"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="10dp"
                android:text="Добавить акцию"
                android:textColor="@drawable/button_state_color"
                android:textSize="@dimen/text_normal" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>