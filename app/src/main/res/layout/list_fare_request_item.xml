<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parentView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_list_item"
    android:clickable="true"
    android:paddingLeft="@dimen/horizontal_margin"
    android:paddingRight="@dimen/horizontal_margin"
    android:paddingBottom="@dimen/vertical_margin_half"
    android:paddingTop="@dimen/vertical_margin_half">

    <FrameLayout
        android:id="@+id/avatarLayout"
        android:layout_width="@dimen/client_avatar_view_width"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vertical_margin_half"
        android:layout_marginRight="@dimen/vertical_margin"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true">

        <com.driverspa.view.ImageViewSquared
            android:id="@+id/imgClientAvatar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
             />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/nameLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="@dimen/vertical_margin_half"
        android:layout_marginTop="@dimen/vertical_margin_third"
        android:layout_below="@id/avatarLayout"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="3dp"
            android:gravity="center"
            android:text="Yerzhan"
            android:textColor="@color/BlueLight"
            android:textSize="@dimen/text_smaller" />

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/min_2"
            android:textColor="@color/BlueLight"
            android:textSize="@dimen/text_smallest" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mainFieldsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@id/avatarLayout"
        android:orientation="vertical"
        android:layout_marginRight="@dimen/vertical_margin"
        android:paddingLeft="@dimen/horizontal_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/car"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/horizontal_margin_third"
                android:layout_marginRight="@dimen/horizontal_margin_half"
                android:layout_weight="1"
                android:drawablePadding="@dimen/vertical_margin_half"
                android:gravity="center|left"
                android:maxLines="2"
                android:text=""
                android:textColor="@color/White"
                android:textSize="@dimen/text_normal" />
        </LinearLayout>

        <TextView
            android:id="@+id/services"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/horizontal_margin_third"
            android:layout_marginRight="@dimen/horizontal_margin_half"
            android:layout_weight="1"
            android:gravity="center|left"
            android:clickable="false"
            android:lines="1"
            android:maxLines="1"
            android:text="@string/body_interior"
            android:textColor="@color/White"
            android:textSize="@dimen/text_small" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginBottom="@dimen/vertical_margin_third"
            android:layout_marginLeft="@dimen/horizontal_margin_half"
            android:layout_marginRight="@dimen/horizontal_margin_half"
            android:layout_marginTop="@dimen/vertical_margin_third"
            android:gravity="right|top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="600 ₸"
                android:textColor="@color/Red"
                android:textSize="@dimen/text_small" />

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginLeft="@dimen/horizontal_margin"
                android:layout_marginTop="4dp"
                android:src="@drawable/ic_distance" />

            <TextView
                android:id="@+id/txtDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vertical_margin_third"
                android:text="~ km"
                android:textColor="@color/White"
                android:textSize="@dimen/text_small" />
        </LinearLayout>

        <TextView
            android:id="@+id/comment"
            style="@style/EditText.Transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/horizontal_margin_third"
            android:layout_marginRight="@dimen/horizontal_margin_half"
            android:layout_weight="1"
            android:gravity="center|left"
            android:clickable="false"
            android:lines="1"
            android:maxLines="2"
            android:text=""
            android:textStyle="italic"
            android:textColor="@color/White"
            android:textSize="@dimen/text_small" />
    </LinearLayout>
</RelativeLayout>